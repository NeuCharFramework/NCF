<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>0.2.1</Version>
		<PackageReleaseNotes>
			[2026-08-04] v0.2.1 增强后台本地化、Footer 配置与 Synchro 状态能力
			1、完善后台页面多语言资源与 Admin Chat 交互适配。
			2、支持安全配置 Footer 内容，并展示服务器时间与 Synchro Provider 状态。
			3、按 XNCF 开放状态聚合 Provider，提供缓存快照和实时变更通知。
			4、升级全部 Senparc.* NuGet 依赖并适配最新 NCF/XNCF 基础库。
		</PackageReleaseNotes>
		<!--<TargetFramework>net5.0</TargetFramework>-->
		<!--<RazorLangVersion>2.0</RazorLangVersion>-->
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<DocumentationFile>../Senparc.Web/App_Data/ApiDocXml/Senparc.Areas.Admin.XML</DocumentationFile>
		<Configurations>Debug;Release;Debug-Dapr;ModifyPublish;ModifyPublish</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<!--<FrameworkReference Include="Microsoft.AspNetCore.App" />-->
		<EmbeddedResource Include="wwwroot\**\*" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.2" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
		<PackageReference Include="Senparc.CO2NET" Version="4.2.0" />
		<PackageReference Include="Senparc.CO2NET.AspNet" Version="2.1.4" />
		<PackageReference Include="Senparc.CO2NET.Cache.CsRedis" Version="2.3.3" />
		<PackageReference Include="Senparc.CO2NET.Cache.Redis" Version="5.3.0" />
		<PackageReference Include="Senparc.CO2NET.WebApi" Version="2.1.9-preview" />
		<PackageReference Include="Senparc.Ncf.AreaBase" Version="0.23.5" />
		<PackageReference Include="Senparc.Ncf.Core" Version="0.29.0-preview8" />
		<PackageReference Include="Senparc.Ncf.Log" Version="0.20.1-preview1" />
		<PackageReference Include="Senparc.Ncf.Mvc.UI" Version="0.22.4-preview8" />
		<PackageReference Include="Senparc.Ncf.Service" Version="0.23.8-preview8" />
		<PackageReference Include="Senparc.Ncf.Utility" Version="0.21.1-preview3" />
		<PackageReference Include="Senparc.Ncf.XncfBase" Version="0.26.0" />
		<PackageReference Include="Senparc.Xncf.AreasBase" Version="0.13.7" />
		<PackageReference Include="Senparc.Xncf.DynamicData" Version="0.7.5" />
		<PackageReference Include="Senparc.Xncf.Menu" Version="0.14.7" />
		<PackageReference Include="Senparc.Xncf.SystemCore" Version="0.14.7" />
		<PackageReference Include="Senparc.Xncf.SystemManager" Version="0.15.7" />
		<PackageReference Include="Senparc.Xncf.SystemPermission" Version="0.15.7" />
		<PackageReference Include="Senparc.Xncf.XncfModuleManager" Version="0.15.7" />
		<PackageReference Include="Senparc.Xncf.Tenant" Version="0.15.7" />
		<PackageReference Include="Senparc.Xncf.WeixinManager" Version="0.24.4" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Areas\Admin\Pages\Dto\" />
	</ItemGroup>
</Project>
