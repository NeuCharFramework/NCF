@page
@model Senparc.Areas.Admin.Areas.Admin.Pages.NeuBell.IndexModel
@{
    ViewData["Title"] = "NeuBell · WebHook 设置";
    Layout = "_Layout_Vue";
}

@section breadcrumbs {
    <el-breadcrumb-item>NeuBell</el-breadcrumb-item>
    <el-breadcrumb-item>WebHook 设置</el-breadcrumb-item>
}

@section Style {
    <link rel="stylesheet" href="~/css/Admin/Pages/NeuBell/Index.css" />
}

<div class="neubell-webhook-page" v-loading="loading">
    <header class="neubell-webhook-header">
        <div>
            <h2>NeuBell WebHook 设置</h2>
            <p>为纽铃（NeuBell）添加外部 WebAPI（WebHook）通知端点。当纽铃条目发生新增（added）或移除（removed）时，系统会按 Provider 过滤条件以异步方式通知到对应地址；支持 GET/POST/PUT 请求方式、请求体模板与 {{占位符}}（与 Workflow 文本模板同格式）；配置签名密钥后请求会携带 HMAC-SHA256 签名头。</p>
        </div>
        <div class="neubell-webhook-header-actions">
            <el-input v-model="keyword" clearable prefix-icon="el-icon-search"
                      placeholder="搜索名称、地址或 Provider"></el-input>
            <el-button icon="el-icon-refresh" @@click="load">刷新</el-button>
            <el-button type="primary" icon="el-icon-plus" @@click="openCreate">新增 WebHook</el-button>
        </div>
    </header>

    <el-table :data="filteredItems" border style="width: 100%" v-if="filteredItems.length">
        <el-table-column label="名称" prop="name" min-width="160" show-overflow-tooltip></el-table-column>
        <el-table-column label="WebHook 地址" prop="webHookUrl" min-width="260" show-overflow-tooltip></el-table-column>
        <el-table-column label="方式" width="80" align="center">
            <template slot-scope="scope">
                <el-tag size="mini" type="info">{{ scope.row.httpMethod || 'POST' }}</el-tag>
            </template>
        </el-table-column>
        <el-table-column label="模板" width="70" align="center">
            <template slot-scope="scope">
                <i v-if="scope.row.bodyTemplate" class="fa fa-check text-success"></i>
                <span v-else class="neubell-muted">—</span>
            </template>
        </el-table-column>
        <el-table-column label="Provider 过滤" min-width="160" show-overflow-tooltip>
            <template slot-scope="scope">
                <el-tag v-if="scope.row.providerFilter" size="mini">{{ scope.row.providerFilter }}</el-tag>
                <span v-else class="neubell-muted">全部</span>
            </template>
        </el-table-column>
        <el-table-column label="签名" align="center" width="80">
            <template slot-scope="scope">
                <el-tag v-if="scope.row.hasSecret" size="mini" type="success">已配置</el-tag>
                <span v-else class="neubell-muted">—</span>
            </template>
        </el-table-column>
        <el-table-column label="新增" align="center" width="70">
            <template slot-scope="scope">
                <i v-if="scope.row.notifyOnAdd" class="fa fa-check text-success"></i>
                <span v-else class="neubell-muted">—</span>
            </template>
        </el-table-column>
        <el-table-column label="移除" align="center" width="70">
            <template slot-scope="scope">
                <i v-if="scope.row.notifyOnRemove" class="fa fa-check text-success"></i>
                <span v-else class="neubell-muted">—</span>
            </template>
        </el-table-column>
        <el-table-column label="启用" align="center" width="90">
            <template slot-scope="scope">
                <el-switch v-model="scope.row.isEnabled" @@change="toggleEnabled(scope.row)"></el-switch>
            </template>
        </el-table-column>
        <el-table-column label="操作" align="center" width="200" fixed="right">
            <template slot-scope="scope">
                <el-button size="mini" icon="el-icon-s-promotion" :loading="scope.row.testing" @@click="sendTest(scope.row)">测试</el-button>
                <el-button size="mini" icon="el-icon-edit" @@click="openEdit(scope.row)">编辑</el-button>
                <el-button size="mini" type="danger" plain icon="el-icon-delete" @@click="removeRow(scope.row)">删除</el-button>
            </template>
        </el-table-column>
    </el-table>
    <div v-else-if="!loading" class="neubell-empty">
        <i class="fa fa-bell-o fa-3x"></i>
        <h3>还没有 WebHook</h3>
        <p>点击右上角“新增 WebHook”，配置一个外部 WebAPI 通知端点。</p>
    </div>

    <section class="neubell-log-section">
        <div class="neubell-log-head">
            <h3><i class="fa fa-list"></i> 请求日志</h3>
            <small>创建 NeuBell 时按参数触发的通知、设置页“测试”与后台监测的变更通知，均在此记录请求数据与结果。</small>
            <span class="neubell-log-actions">
                <el-button size="mini" icon="el-icon-refresh" @@click="loadLogs">刷新</el-button>
                <el-button size="mini" type="danger" plain icon="el-icon-delete" @@click="clearLogs">清空（保留 50 条）</el-button>
            </span>
        </div>
        <el-table :data="logRows" border size="mini" style="width: 100%" v-loading="logLoading">
            <el-table-column label="时间" width="160">
                <template slot-scope="scope">{{ formatTime(scope.row.addTime) }}</template>
            </el-table-column>
            <el-table-column label="类型" width="120">
                <template slot-scope="scope">
                    <el-tag size="mini" :type="kindTagType(scope.row.eventKind)">{{ kindLabel(scope.row.eventKind) }}</el-tag>
                </template>
            </el-table-column>
            <el-table-column label="WebHook 地址" prop="webHookUrl" min-width="220" show-overflow-tooltip></el-table-column>
            <el-table-column label="方式" width="80" align="center">
                <template slot-scope="scope">
                    <el-tag size="mini" type="info">{{ scope.row.httpMethod || '—' }}</el-tag>
                </template>
            </el-table-column>
            <el-table-column label="Provider" prop="providerId" min-width="140" show-overflow-tooltip></el-table-column>
            <el-table-column label="状态" width="90" align="center">
                <template slot-scope="scope">
                    <el-tag size="mini" :type="statusTagType(scope.row.status)">{{ statusLabel(scope.row.status) }}</el-tag>
                </template>
            </el-table-column>
            <el-table-column label="HTTP" width="70" align="center">
                <template slot-scope="scope">{{ scope.row.statusCode || '—' }}</template>
            </el-table-column>
            <el-table-column label="耗时" width="80" align="center">
                <template slot-scope="scope">{{ scope.row.status === 'sending' ? '—' : (scope.row.elapsedMilliseconds + ' ms') }}</template>
            </el-table-column>
            <el-table-column label="结果" prop="result" min-width="160" show-overflow-tooltip></el-table-column>
            <el-table-column label="操作" width="150" align="center" fixed="right">
                <template slot-scope="scope">
                    <el-button size="mini" type="text" icon="el-icon-document" @@click="showPayload(scope.row)">报文</el-button>
                    <el-button size="mini" type="text" icon="el-icon-delete" @@click="removeLog(scope.row)">删除</el-button>
                </template>
            </el-table-column>
        </el-table>
        <div v-if="!logLoading && logRows.length === 0" class="neubell-log-empty">暂无请求日志。</div>
    </section>

    <el-dialog title="WebHook 请求报文" :visible.sync="payloadVisible" width="640px">
        <div class="neubell-payload-meta" v-if="payloadRow">
            <el-tag size="mini" :type="statusTagType(payloadRow.status)">{{ statusLabel(payloadRow.status) }}</el-tag>
            <span class="neubell-payload-url">{{ payloadRow.webHookUrl }}</span>
        </div>
        <pre class="neubell-payload" v-loading="payloadLoading">{{ payloadText }}</pre>
        <span slot="footer">
            <el-button @@click="payloadVisible = false">关闭</el-button>
        </span>
    </el-dialog>

    <el-dialog :title="form.id ? '编辑 WebHook' : '新增 WebHook'" :visible.sync="formDialogVisible"
               width="680px" :close-on-click-modal="false">
        <el-form label-width="110px">
            <el-form-item label="名称" required>
                <el-input v-model="form.name" maxlength="200" placeholder="例如：运维值班机器人"></el-input>
            </el-form-item>
            <el-form-item label="WebHook 地址" required>
                <el-input v-model="form.webHookUrl" maxlength="1000"
                          placeholder="https://example.com/api/neubell-webhook 或 https://example.com/hook/{{kind}}/{{title}}"></el-input>
            </el-form-item>
            <el-form-item label="请求方式">
                <el-select v-model="form.httpMethod" style="width: 180px">
                    <el-option label="POST（默认，携带 JSON 请求体）" value="POST"></el-option>
                    <el-option label="GET（不发送请求体，数据经地址占位符传递）" value="GET"></el-option>
                    <el-option label="PUT（携带请求体）" value="PUT"></el-option>
                </el-select>
            </el-form-item>
            <el-form-item label="请求体模板">
                <el-input v-model="form.bodyTemplate" type="textarea" :rows="4" maxlength="20000" show-word-limit
                          placeholder='留空使用系统默认 JSON 报文；以 { 或 [ 开头按 JSON 处理。例如：{"text": "[NeuBell] {{title}}（{{status}}）{{link}}"}'></el-input>
                <div class="neubell-token-help">
                    <p><b>占位符</b>（与 Workflow 文本模板同格式，<code>{{name}}</code>）：</p>
                    <p><code>{{kind}}</code> 事件类型（item-created / items-changed / test）·
                       <code>{{action}}</code> 动作值 · <code>{{actionName}}</code> 动作名称 ·
                       <code>{{actionStatus}}</code> 动作结果（success / empty）·
                       <code>{{operation}}</code> 机器可读操作状态（created / added / removed / changed / none）·
                       <code>{{operationStatus}}</code> 操作状态说明（创建 / 新增 / 移除 / 变更 / 无变化）·
                       <code>{{payload}}</code> 完整默认 JSON 报文</p>
                    <p><code>{{provider}}</code> ProviderId · <code>{{providerName}}</code> Provider 名称 ·
                       <code>{{time}}</code> 通知时间（ISO 8601）· <code>{{moduleUid}}</code> 模块 UID ·
                       <code>{{tenantId}}</code> 租户标识（无租户时为空）</p>
                    <p><code>{{id}}</code> 条目 Id · <code>{{title}}</code> 条目标题 · <code>{{summary}}</code> 条目摘要 ·
                       <code>{{link}}</code> 条目链接（配置站点根地址时为绝对链接）· <code>{{status}}</code> 严重程度 ·
                       <code>{{count}}</code> 数量 · <code>{{updated}}</code> 条目更新时间</p>
                    <p><code>{{addedCount}}</code>/<code>{{removedCount}}</code> 本次新增/移除数量 ·
                       <code>{{addedTitles}}</code>/<code>{{removedTitles}}</code> 本次新增/移除标题（以“、”连接）</p>
                    <p class="neubell-token-notes">说明：URL 中的占位符替换值自动 URL 编码；JSON 模板中字符串占位符自动 JSON 转义，
                       <code>{{payload}}</code> 原样嵌入；未知占位符替换为空字符串；GET 不发送请求体（模板不生效），
                       签名仅对携带请求体的请求生效。</p>
                </div>
            </el-form-item>
            <el-form-item label="Provider 过滤">
                <el-select v-model="form.providerFilter" clearable filterable placeholder="留空表示全部 Provider"
                           style="width: 100%">
                    <el-option v-for="p in providers" :key="p.providerId"
                               :label="p.displayName || p.providerId" :value="p.providerId"></el-option>
                </el-select>
            </el-form-item>
            <el-form-item label="签名密钥">
                <el-input v-model="form.secret" :type="form.id && !form.showSecret ? 'password' : 'text'" maxlength="300"
                          placeholder="配置后请求携带 X-NeuBell-Signature（HMAC-SHA256）"></el-input>
            </el-form-item>
            <el-form-item label="新增时通知">
                <el-switch v-model="form.notifyOnAdd"></el-switch>
            </el-form-item>
            <el-form-item label="移除时通知">
                <el-switch v-model="form.notifyOnRemove"></el-switch>
            </el-form-item>
            <el-form-item label="启用">
                <el-switch v-model="form.isEnabled"></el-switch>
            </el-form-item>
        </el-form>
        <span slot="footer">
            <el-button @@click="formDialogVisible = false">取消</el-button>
            <el-button type="primary" :loading="formSaving" @@click="saveRow">保存</el-button>
        </span>
    </el-dialog>
</div>

@section scripts {
    <script src="~/js/Admin/Pages/NeuBell/Index.js"></script>
}
