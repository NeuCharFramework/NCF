@page
@model Senparc.Areas.Admin.Pages.AdminChat.ChatModel
@{
    ViewData["Title"] = AR["Admin.Home.AiTitle"];
    Layout = "_Layout_Vue";
}

@section Style {
    <link rel="stylesheet" href="~/css/Admin/Pages/AdminChat/ChatLauncher.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin/Pages/AdminChat/Chat.css" />
}

@section breadcrumbs {
    <el-breadcrumb-item>@AR["Admin.Home.AiTitle"]</el-breadcrumb-item>
    <el-breadcrumb-item>@AR["AdminChat.Conversation"]</el-breadcrumb-item>
}

<div class="admin-chat-container">
    <el-container class="chat-main-container">
        <!-- 左侧会话历史 -->
        <el-aside width="280px" class="chat-sidebar">
            <div class="sidebar-header">
                <h3 class="sidebar-title">
                    <i class="fa fa-comments"></i> @AR["AdminChat.History"]
                </h3>
                <el-button 
                    type="primary" 
                    size="small" 
                    icon="el-icon-plus" 
                    @@click="createNewSession">
                    @AR["AdminChat.NewConversation"]
                </el-button>
            </div>
            
            <div class="session-list" v-loading="loadingSessions">
                <div 
                    v-for="session in sessionList" 
                    :key="session.id"
                    :class="['session-item', { 'active': currentSessionId === session.id }]"
                    @@click="switchSession(session.id)">
                    <div class="session-info">
                        <div class="session-title">{{ session.title }}</div>
                        <div class="session-time">{{ formatTime(session.lastMessageTime) }}</div>
                    </div>
                    <el-dropdown trigger="click" @@command="handleSessionCommand">
                        <span class="session-actions" @@click.stop>
                            <i class="el-icon-more"></i>
                        </span>
                        <el-dropdown-menu slot="dropdown">
                            <el-dropdown-item :command="{action: 'delete', id: session.id}">
                                <i class="fa fa-trash"></i> @AR["Common.删除"]
                            </el-dropdown-item>
                        </el-dropdown-menu>
                    </el-dropdown>
                </div>
                
                <div v-if="sessionList.length === 0 && !loadingSessions" class="empty-sessions">
                    <i class="fa fa-comments-o"></i>
                    <p>@AR["AdminChat.EmptyHistory"]</p>
                </div>
            </div>
        </el-aside>

        <!-- 右侧对话窗口 -->
        <el-main class="chat-content">
            <div class="chat-header" v-if="currentSessionId">
                <div class="chat-header-info">
                    <div class="chat-header-top">
                        <h3 class="chat-title">
                            <i class="fa fa-magic"></i> {{ currentSessionTitle || ncfT('Admin.Home.AiTitle') }}
                        </h3>
                        <div class="chat-header-actions">
                            <el-select
                                v-model="currentSessionAiModelId"
                                size="mini"
                                class="chat-ai-model-select"
                                :loading="loadingAiModelOptions"
                                @@change="handleCurrentSessionAiModelChange"
                                placeholder="@AR["AdminChat.SelectModel"]">
                                <el-option
                                    v-for="item in aiModelOptions"
                                    :key="item.id"
                                    :label="item.name"
                                    :value="item.id">
                                    <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;">
                                        <span>{{ item.name }}</span>
                                        <span style="color:#999;font-size:12px;">{{ item.description }}</span>
                                    </div>
                                </el-option>
                            </el-select>
                            <el-button
                                size="mini"
                                :type="isManageMode ? 'default' : 'primary'"
                                @@click="toggleManageMode">
                                {{ isManageMode ? ncfT('AdminChat.Done') : ncfT('AdminChat.Manage') }}
                            </el-button>
                            <el-button
                                size="mini"
                                type="text"
                                title="任务轨迹"
                                @@click="openTrajectoryDialog">
                                <i class="fa fa-road"></i>
                            </el-button>
                        </div>
                    </div>
                    <div class="chat-modules" v-if="currentSessionModules.length > 0">
                        <el-popover
                            v-for="module in currentSessionModules"
                            :key="module.id"
                            placement="bottom-start"
                            width="420"
                            trigger="hover"
                            popper-class="chat-module-detail-popover">
                            <div class="chat-module-detail-wrapper">
                                <div class="module-selector-preview-title">
                                    <i :class="[resolveModuleDetail(module).icon, 'selector-module-icon']"></i>
                                    <span>{{ resolveModuleDetail(module).name }}</span>
                                    <span class="selector-module-version" v-if="resolveModuleDetail(module).version">v{{ resolveModuleDetail(module).version }}</span>
                                </div>
                                <div class="module-selector-preview-subtitle">{{ resolveModuleDetail(module).description }}</div>

                                <div class="module-selector-preview-body">
                                    <div class="module-selector-preview-section" v-if="resolveModuleDetail(module).menus && resolveModuleDetail(module).menus.length > 0">
                                        <div class="module-selector-preview-section-title">@AR["AdminChat.MenuHierarchy"]</div>
                                        <el-tree
                                            :data="resolveModuleDetail(module).menus"
                                            node-key="id"
                                            :props="{ label: 'name', children: 'children' }"
                                            default-expand-all
                                            class="module-selector-menu-tree">
                                            <span class="custom-tree-node" slot-scope="{ data }">
                                                <a :href="data.url">{{ data.name }}</a>
                                            </span>
                                        </el-tree>
                                    </div>

                                    <div class="module-selector-preview-section" v-if="resolveModuleDetail(module).functions && resolveModuleDetail(module).functions.length > 0">
                                        <div class="module-selector-preview-section-title">@AR["AdminChat.Functions"]</div>
                                        <div class="module-selector-functions-list">
                                            <div v-for="func in resolveModuleDetail(module).functions" :key="func.name" class="module-selector-function-item">
                                                <div class="module-selector-function-name">{{ func.name }}</div>
                                                <div class="module-selector-function-description">{{ func.description }}</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div
                                        class="module-selector-preview-empty"
                                        v-if="(!resolveModuleDetail(module).menus || resolveModuleDetail(module).menus.length === 0) && (!resolveModuleDetail(module).functions || resolveModuleDetail(module).functions.length === 0)">
                                        @AR["AdminChat.NoPreview"]
                                    </div>
                                </div>
                            </div>

                            <el-tag
                                slot="reference"
                                size="mini"
                                type="info"
                                :title="module.moduleDescription || module.xncfModuleUid"
                                class="chat-module-tag-detail">
                                <i class="fa fa-cube"></i>
                                {{ module.displayName || module.menuName || module.moduleName || module.xncfModuleUid }}
                                <span v-if="module.moduleVersion"> v{{ module.moduleVersion }}</span>
                            </el-tag>
                        </el-popover>
                    </div>
                    <div class="chat-modules" v-if="currentSessionWorkflows.length > 0">
                        <el-popover
                            v-for="workflow in currentSessionWorkflows"
                            :key="workflow.id"
                            placement="bottom-start"
                            width="360"
                            trigger="hover"
                            popper-class="chat-module-detail-popover">
                            <div class="chat-module-detail-wrapper">
                                <div class="module-selector-preview-title">
                                    <i class="fa fa-random selector-module-icon"></i>
                                    <span>{{ workflow.workflowName }}</span>
                                    <span class="selector-module-version">#{{ workflow.workflowId }}</span>
                                </div>
                                <div class="module-selector-preview-subtitle">{{ workflow.workflowDescription || '已启用 Workflow' }}</div>
                                <div class="module-selector-preview-section" v-if="workflow.parameters && workflow.parameters.length > 0">
                                    <div class="module-selector-preview-section-title">Function Calling 参数</div>
                                    <div class="module-selector-functions-list">
                                        <div v-for="parameter in workflow.parameters"
                                             :key="`session-workflow-${workflow.workflowId}-${parameter.name}`"
                                             class="module-selector-function-item">
                                            <div class="module-selector-function-name">{{ parameter.name }}</div>
                                            <div class="module-selector-function-description">{{ parameter.description || '可选参数' }}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <el-tag
                                slot="reference"
                                size="mini"
                                type="success"
                                class="chat-workflow-tag">
                                <i class="fa fa-random"></i>
                                {{ workflow.workflowName }}
                            </el-tag>
                        </el-popover>
                    </div>
                </div>
            </div>

            <div class="messages-container" ref="messagesContainer" v-loading="loadingMessages" v-if="currentSessionId">
                <div class="message-manage-toolbar" v-if="isManageMode">
                    <el-checkbox
                        :value="messageList.length > 0 && selectedMessageIds.length === messageList.length"
                        :indeterminate="selectedMessageIds.length > 0 && selectedMessageIds.length < messageList.length"
                        @@change="toggleSelectAllMessages">
                        @AR["AdminChat.SelectAll"]
                    </el-checkbox>
                    <span class="message-manage-count">{{ ncfT('AdminChat.SelectedCount', selectedMessageIds.length) }}</span>
                    <el-button size="mini" @@click="copySelectedMessages" :disabled="selectedMessageIds.length === 0">@AR["AdminChat.Copy"]</el-button>
                    <el-button size="mini" @@click="clearMessageSelection" :disabled="selectedMessageIds.length === 0">@AR["AdminChat.ClearSelection"]</el-button>
                    <el-button size="mini" type="danger" @@click="deleteSelectedMessages" :disabled="selectedMessageIds.length === 0">@AR["Common.删除"]</el-button>
                </div>

                <div 
                    v-for="message in messageList" 
                    :key="message.id"
                    :class="['message-item', `message-${getRoleTypeClass(message.roleType)}`, { 'is-selected': isManageMode && isMessageSelected(message.id) }]">
                    <div class="message-select" v-if="isManageMode">
                        <el-checkbox
                            :value="isMessageSelected(message.id)"
                            @@change="() => toggleMessageSelection(message.id)"
                            @@click.native.stop>
                        </el-checkbox>
                    </div>
                    <div class="message-avatar">
                        <i :class="getMessageIcon(message.roleType)"></i>
                    </div>
                    <div class="message-content">
                        <div class="message-meta">
                            <span class="message-role">{{ getRoleTypeName(message.roleType) }}</span>
                            <span class="message-time">{{ formatTime(message.addTime) }}</span>
                        </div>
                        <div class="message-text" v-html="formatMessageContent(message.content)"></div>
                        <div class="message-harness-steps" v-if="message.roleType === 1 && !isManageMode && message.harnessSteps && message.harnessSteps.length > 0">
                            <el-collapse class="harness-collapse">
                                <el-collapse-item :title="harnessStepsTitle(message.harnessSteps)">
                                    <div class="harness-step" v-for="(step, idx) in message.harnessSteps" :key="idx">
                                        <div class="harness-step-head">
                                            <span class="harness-step-index">
                                                <i :class="step.isFinal ? 'fa fa-flag-checkered' : (step.timedOut ? 'fa fa-exclamation-triangle' : 'fa fa-arrow-circle-right')"></i>
                                                {{ step.index }}
                                            </span>
                                            <i v-if="step.isFinal" class="fa fa-flag-checkered harness-step-done"></i>
                                            <i v-else-if="step.timedOut" class="fa fa-exclamation-triangle harness-step-timeout"></i>
                                        </div>
                                        <div class="harness-step-body" v-html="formatMessageContent(step.output)"></div>
                                    </div>
                                </el-collapse-item>
                            </el-collapse>
                        </div>
                        <div class="message-trajectory-actions" v-if="message.roleType === 1 && !isManageMode && message.trajectoryId">
                            <el-button type="text" size="mini" @@click="openTrajectory(message.trajectoryId)">
                                <i class="fa fa-road"></i> 轨迹
                            </el-button>
                            <el-button v-if="canResumeMessage(message)" type="text" size="mini" @@click="resumeTrajectory(message.trajectoryId)">
                                <i class="fa fa-play"></i> 恢复
                            </el-button>
                            <el-button type="text" size="mini" @@click="forkTrajectory(message.trajectoryId, message.trajectorySequence)">
                                <i class="fa fa-code-fork"></i> 分叉
                            </el-button>
                        </div>
                        <div class="message-trajectory-approvals" v-if="message.roleType === 1 && !isManageMode && message.pendingApprovals && message.pendingApprovals.length > 0">
                            <div v-for="approval in message.pendingApprovals" :key="approval.requestId" class="trajectory-approval-item">
                                <span><i class="fa fa-shield"></i> {{ approval.toolName }}</span>
                                <el-button type="success" size="mini" @@click="respondApproval(message.trajectoryId, approval, true)">允许</el-button>
                                <el-button type="danger" plain size="mini" @@click="respondApproval(message.trajectoryId, approval, false)">拒绝</el-button>
                            </div>
                        </div>
                        <div class="message-actions" v-if="message.roleType === 1 && !isManageMode">
                            <el-button 
                                type="text" 
                                size="mini"
                                :class="{ 'active': message.userFeedback === 1 }"
                                @@click="setFeedback(message.id, 1)">
                                <i class="fa fa-thumbs-up"></i>
                            </el-button>
                            <el-button 
                                type="text" 
                                size="mini"
                                :class="{ 'active': message.userFeedback === 2 }"
                                @@click="setFeedback(message.id, 2)">
                                <i class="fa fa-thumbs-down"></i>
                            </el-button>
                        </div>
                    </div>
                </div>

                <div v-if="messageList.length === 0 && !loadingMessages" class="empty-messages">
                    <i class="fa fa-comment-o"></i>
                    <p>@AR["AdminChat.StartPrompt"]</p>
                </div>

                <div v-if="isAIResponding" class="message-item message-assistant ai-thinking live-run-panel">
                    <div class="message-avatar">
                        <i class="fa fa-robot"></i>
                    </div>
                    <div class="message-content">
                        <div class="message-meta">
                            <span class="message-role">@AR["AdminChat.RoleAssistant"]</span>
                            <span class="live-run-status">{{ liveStatusText || (chatMode === 'harness' ? '正在规划任务…' : '正在生成回答…') }}</span>
                        </div>
                        <div class="message-text" v-if="liveAssistantText">
                            <div class="live-answer-preview" v-html="formatMessageContent(liveAssistantText)"></div>
                        </div>
                        <div class="message-text" v-else>
                            <span class="typing-indicator">
                                <span></span><span></span><span></span>
                            </span>
                            @AR["AdminChat.Thinking"]
                        </div>
                        <el-collapse v-if="liveTrajectoryEvents.length > 0" class="live-trajectory-collapse">
                            <el-collapse-item title="查看实时执行过程">
                                <div v-for="event in liveTrajectoryEvents" :key="`live-${event.correlationId || event.id || event.sequence}`" class="live-trajectory-event">
                                    <div class="live-trajectory-event-title">
                                        <span>{{ trajectoryEventLabel(event.eventType) }}</span>
                                        <strong v-if="event.name">{{ event.name }}</strong>
                                    </div>
                                    <div v-if="event.content" class="live-trajectory-event-content">{{ event.content }}</div>
                                </div>
                            </el-collapse-item>
                        </el-collapse>
                        <div v-if="livePendingApprovals.length > 0" class="live-approval-hint">
                            <i class="fa fa-shield"></i> 等待工具确认
                        </div>
                    </div>
                </div>
            </div>

            <div class="input-container" v-if="currentSessionId">
                <el-input
                    type="textarea"
                    v-model="inputMessage"
                    placeholder="@AR["AdminChat.InputPlaceholder"]"
                    :rows="3"
                    :disabled="!currentSessionId || isSending"
                    @@keydown.native="handleChatInputKeydown"
                    class="message-input">
                </el-input>
                <div class="input-actions">
                    <span class="input-tip">
                        <i class="fa fa-info-circle"></i> @AR["AdminChat.SendHint"]
                    </span>
                    <el-radio-group v-model="chatMode" size="mini" class="chat-mode-toggle" :disabled="isSending">
                        <el-radio-button label="simple">
                            <i class="fa fa-comment"></i> @AR["AdminChat.ModeSimple"]
                        </el-radio-button>
                        <el-radio-button label="harness">
                            <i class="fa fa-rocket"></i> @AR["AdminChat.ModeHarness"]
                        </el-radio-button>
                    </el-radio-group>
                    <el-button
                        v-if="isSending"
                        type="danger"
                        icon="el-icon-close"
                        :loading="isStopping"
                        :disabled="isStopping"
                        @@click="stopCurrentRequest">
                        终止
                    </el-button>
                    <el-button
                        v-else
                        type="primary"
                        icon="el-icon-s-promotion"
                        :disabled="!currentSessionId || !inputMessage || inputMessage.trim().length === 0"
                        @@click="sendMessage">
                        @AR["AdminChat.Send"]
                    </el-button>
                </div>
            </div>

            <div class="chat-empty-launcher" v-else>
                <el-card class="box-card chat-entrance-card">
                    <div class="chat-entrance-container">
                        <div class="chat-entrance-header">
                            <div class="chat-entrance-icon">
                                <i class="fa fa-comments"></i>
                            </div>
                            <div class="chat-entrance-content">
                                <h3 class="chat-entrance-title">
                                    <i class="fa fa-magic"></i> @AR["Admin.Home.AiTitle"]
                                </h3>
                                <p class="chat-entrance-subtitle">@AR["AdminChat.NewSessionDescription"]</p>
                            </div>
                        </div>

                        <div class="chat-entrance-input-wrapper">
                            <div class="chat-launcher-controls">
                                <div class="launcher-control launcher-control-model">
                                    <div class="launcher-control-label">
                                        <i class="fa fa-bolt"></i>
                                        <span>@AR["AdminChat.ComputePower"]</span>
                                    </div>
                                <el-select
                                    v-model="launcherAiModelId"
                                    class="chat-ai-model-select"
                                    :loading="loadingAiModelOptions"
                                    placeholder="@AR["AdminChat.SelectModel"]"
                                    >
                                    <el-option
                                        v-for="item in aiModelOptions"
                                        :key="`launcher-${item.id}`"
                                        :label="item.name"
                                        :value="item.id">
                                        <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;">
                                            <span>{{ item.name }}</span>
                                            <span style="color:#999;font-size:12px;">{{ item.description }}</span>
                                        </div>
                                    </el-option>
                                </el-select>
                                </div>

                                <div class="launcher-control launcher-control-mode">
                                    <div class="launcher-control-label">
                                        <i class="fa fa-sliders"></i>
                                        <span>执行模式</span>
                                    </div>
                                    <el-radio-group v-model="launcherChatMode" size="small" class="launcher-mode-toggle">
                                    <el-radio-button label="simple">
                                        <i class="fa fa-comment"></i> @AR["AdminChat.ModeSimple"]
                                    </el-radio-button>
                                    <el-radio-button label="harness">
                                        <i class="fa fa-rocket"></i> @AR["AdminChat.ModeHarness"]
                                    </el-radio-button>
                                    </el-radio-group>
                                </div>
                            </div>

                            <el-input
                                type="textarea"
                                v-model="chatInputText"
                                placeholder="@AR["Admin.Home.AiPlaceholder"]"
                                :rows="4"
                                :autosize="{ minRows: 4, maxRows: 8 }"
                                @@keydown.native="handleLauncherInputKeydown"
                                class="chat-entrance-input"
                                resize="none">
                            </el-input>
                            <el-button
                                type="primary"
                                size="medium"
                                icon="el-icon-s-promotion"
                                @@click="startChatSession"
                                :disabled="!chatInputText || chatInputText.trim().length === 0"
                                :loading="isCreatingSession"
                                class="chat-send-button">
                                @AR["Admin.Home.StartConversation"]
                            </el-button>
                        </div>

                        <div class="chat-module-picker chat-reference-picker">
                            <div class="chat-module-picker-header">
                                <div class="chat-reference-title">
                                    <span class="chat-module-picker-title">@AR["Admin.Home.ReferenceModules"]</span>
                                    <span class="chat-reference-count" v-if="selectedModules.length + selectedWorkflows.length > 0">
                                        {{ selectedModules.length + selectedWorkflows.length }}
                                    </span>
                                    <span class="chat-reference-optional">可选</span>
                                </div>
                                <div class="chat-module-picker-actions">
                                    <el-button size="mini" type="primary" plain icon="el-icon-plus" @@click="openModuleSelector">@AR["Admin.Home.AddReferenceModule"]</el-button>
                                    <el-button size="mini" type="text" @@click="clearSelectedModules" v-if="selectedModules.length > 0 || selectedWorkflows.length > 0">
                                        <i class="fa fa-eraser"></i> @AR["Admin.Home.Clear"]
                                    </el-button>
                                </div>
                            </div>

                            <div v-if="selectedModules.length > 0 || selectedWorkflows.length > 0" class="chat-reference-tags">
                                <div v-if="selectedModules.length > 0" class="chat-module-selected-list chat-reference-tag-row">
                                    <el-tag
                                        v-for="module in selectedModules"
                                        :key="module.uid"
                                        closable
                                        @@close="removeModule(module.uid)"
                                        type="info"
                                        class="module-tag">
                                        <i :class="module.icon" aria-hidden="true"></i>
                                        <span class="module-tag-name">{{module.name}}</span>
                                    </el-tag>
                                </div>
                                <div v-if="selectedWorkflows.length > 0" class="chat-module-selected-list chat-reference-tag-row chat-workflow-tag-row">
                                    <el-tag
                                        v-for="workflow in selectedWorkflows"
                                        :key="`selected-workflow-${workflow.id}`"
                                        closable
                                        @@close="removeWorkflow(workflow.id)"
                                        type="success"
                                        class="module-tag">
                                        <i class="fa fa-random" aria-hidden="true"></i>
                                        <span class="module-tag-name">{{workflow.name}}</span>
                                    </el-tag>
                                </div>
                            </div>
                            <div v-else class="chat-module-selected-empty">
                                <i class="fa fa-lightbulb-o"></i>
                                <span>不引用模块也可以直接开始</span>
                            </div>
                        </div>

                        @await Html.PartialAsync("~/Areas/Admin/Pages/Shared/_ChatModuleSelectorDialog.cshtml")
                    </div>
                </el-card>
            </div>
        </el-main>
    </el-container>
    <el-dialog
        title="Harness 任务轨迹"
        :visible.sync="trajectoryDialogVisible"
        width="760px"
        custom-class="trajectory-dialog">
        <div class="trajectory-toolbar">
            <el-input
                v-model="trajectorySearchText"
                clearable
                size="small"
                placeholder="检索轨迹、工具或结果"
                @@keyup.enter.native="searchTrajectories">
                <el-button slot="append" icon="el-icon-search" @@click="searchTrajectories"></el-button>
            </el-input>
        </div>
        <div class="trajectory-list" v-loading="trajectoryLoading">
            <div
                v-for="trajectory in trajectoryList"
                :key="trajectory.id"
                :class="['trajectory-list-item', { active: selectedTrajectory && selectedTrajectory.id === trajectory.id }]"
                @@click="openTrajectory(trajectory.id)">
                <div>
                    <strong>{{ trajectory.title }}</strong>
                    <span class="trajectory-status">{{ trajectoryStatusLabel(trajectory.status) }}</span>
                </div>
                <small>#{{ trajectory.id }} · {{ trajectory.lastSequence }} events · {{ formatTime(trajectory.startedAt) }}</small>
            </div>
            <div v-if="trajectoryList.length === 0 && !trajectoryLoading" class="trajectory-empty">暂无 Harness 轨迹</div>
        </div>
        <div class="trajectory-detail" v-if="selectedTrajectory" v-loading="trajectoryDetailLoading">
            <div class="trajectory-detail-head">
                <div>
                    <strong>{{ selectedTrajectory.title }}</strong>
                    <span class="trajectory-status">{{ trajectoryStatusLabel(selectedTrajectory.status) }}</span>
                </div>
                <div class="trajectory-detail-actions">
                    <el-button size="mini" @@click="toggleTrajectoryReplay">
                        <i :class="replayPlaying ? 'fa fa-pause' : 'fa fa-play-circle'"></i>
                        {{ replayPlaying ? '暂停回放' : '回放' }}
                    </el-button>
                    <el-button size="mini" type="primary" @@click="resumeSelectedTrajectory">
                        <i class="fa fa-play"></i> 恢复
                    </el-button>
                    <el-button size="mini" @@click="forkSelectedTrajectory">
                        <i class="fa fa-code-fork"></i> 分叉
                    </el-button>
                </div>
            </div>
            <div class="trajectory-replay-banner" v-if="replayEvent">
                <span>回放事件 #{{ replayEvent.sequence }} · {{ replayEvent.eventType }}</span>
                <strong v-if="replayEvent.name">{{ replayEvent.name }}</strong>
                <div v-if="replayEvent.content">{{ replayEvent.content }}</div>
            </div>
            <div ref="trajectoryTimeline" class="trajectory-timeline">
                <el-timeline>
                    <el-timeline-item
                        v-for="event in selectedTrajectoryEvents"
                        :key="event.id || event.sequence"
                        :timestamp="formatTime(event.occurredAt)"
                        placement="top">
                        <div
                            :id="trajectoryEventDomId(event.sequence)"
                            :class="['trajectory-event', { 'is-replay-current': replayEvent && replayEvent.sequence === event.sequence }]"
                            @@click="selectReplayEvent(selectedTrajectoryEvents.indexOf(event))">
                            <div class="trajectory-event-title">
                                <span>#{{ event.sequence }} {{ trajectoryEventLabel(event.eventType) }}</span>
                                <strong v-if="event.name">{{ event.name }}</strong>
                            </div>
                            <div class="trajectory-event-content" v-if="event.content">{{ event.content }}</div>
                            <pre class="trajectory-event-payload" v-if="event.payloadJson">{{ formatTrajectoryPayload(event.payloadJson) }}</pre>
                        </div>
                    </el-timeline-item>
                </el-timeline>
            </div>
        </div>
    </el-dialog>
</div>

@section scripts {
    <script src="~/js/Admin/Pages/AdminChat/ChatLauncherMixin.js"></script>
    <script src="~/js/Admin/lib/marked.min.js"></script>
    <script src="~/js/Admin/dompurify.min.js"></script>
    <script>
        window.INITIAL_DATA = {
            sessionId: @Model.SessionId,
            initialMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InitialMessage ?? string.Empty)),
            currentUserId: @Model.CurrentUserId,
            moduleUids: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ModuleUids ?? string.Empty))
        };
    </script>
    <script src="~/js/Admin/Pages/AdminChat/Chat.js"></script>
}
