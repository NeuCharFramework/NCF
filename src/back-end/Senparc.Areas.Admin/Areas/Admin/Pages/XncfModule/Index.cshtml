@page
@model Senparc.Areas.Admin.Areas.Admin.Pages.XncfModuleIndexModel
@using Senparc.Ncf.Core.Areas;
@using Senparc.Ncf.XncfBase;
@{
    ViewData["Title"] = AR["Xncf.Title"];
    Layout = "_Layout_Vue";
}
@section Style {
    <link href="~/css/Admin/XncfModule/XncfModule.css" rel="stylesheet" />
}
@section breadcrumbs {
    <el-breadcrumb-item>@AR["Xncf.ExtensionModules"]</el-breadcrumb-item>
    <el-breadcrumb-item>@AR["Xncf.Title"]</el-breadcrumb-item>
}
<div class="common-layout">
    <el-container>
        <el-header height="50px">
            <div class="filter-container" style="text-align: right; margin-top:10px">
                <el-popconfirm placement="top" :title="handlerTips" @@on-confirm="handleSwitch">
                    <el-button size="mini" type="danger" slot="reference">{{handlerText}}</el-button>
                </el-popconfirm>
            </div>
        </el-header>
        <el-main>
            <el-tabs v-model="activeTab" type="border-card" class="demo-tabs" @@tab-click="handleTabClick">
                <el-tab-pane name="new">
                    <template #label>
                        @AR["Xncf.NewModules"]<sup class="el-badge__content">{{newTableData.length}}</sup>
                    </template>
                    <template #add-icon>
                        <el-popconfirm placement="top" :title="handlerTips" @@on-confirm="handleSwitch">
                            <el-button size="mini" type="danger" slot="reference">{{handlerText}}</el-button>
                        </el-popconfirm>
                    </template>
                    <el-table :data="newTableData.filter(data => !newTableSearch || data.name.includes(newTableSearch))"
                                style="width: 100%;margin-bottom: 20px;">
                        <el-table-column align="left" label="@AR["Xncf.ModuleName"]">
                            <template slot-scope="scope">
                                <i class="fa fa-cubes"></i>
                                {{scope.row.name}}
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.MenuName"]">
                            <template slot-scope="scope">
                                <i :class="scope.row.icon"></i>
                                {{scope.row.menuName}}

                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.Version"]">
                            <template slot-scope="scope">
                                <i class="fa fa-code-fork"></i>
                                {{scope.row.version}}
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.UniqueCode"]" width="350">
                            <template slot-scope="scope">
                                <i class="fa fa-shield"></i>
                                {{scope.row.uid}}
                            </template>
                        </el-table-column>
                        <el-table-column label="@AR["Xncf.Actions"]" width="95">
                            <template slot="header" slot-scope="scope">
                                <el-input v-model="newTableSearch"
                                            size="mini"
                                            placeholder="@AR["Xncf.Search"]" />
                            </template>
                            <template slot-scope="scope">
                                <el-button size="mini"
                                            type="primary"
                                            icon="el-icon-circle-plus"
                                            @@click="handleInstall(scope.$index, scope.row)">@AR["Xncf.Install"]</el-button>
                            </template>
                        </el-table-column>
                    </el-table>
                </el-tab-pane>
                <el-tab-pane name="installed" label="@AR["Xncf.InstalledModules"]">
                    <el-table :data="oldTableData.filter(data => !oldTableSearch || data.xncfModule.name.includes(oldTableSearch))"
                                v-if="oldTableData.length>0"
                                style="width: 100%;margin-bottom: 20px;">
                        <el-table-column align="left" label="@AR["Xncf.MenuAndVersion"]">
                            <template slot-scope="scope">
                                <div>
                                    <i :class="scope.row.xncfRegister?scope.row.xncfRegister.icon:'fa fa-chain-broken'"></i>
                                    {{scope.row.xncfModule.menuName}}
                                </div>
                                <div>
                                    <i class="fa fa-code-fork"></i>
                                    v{{scope.row.xncfModule.version}}
                                </div>
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.ModuleAndCode"]" width="350">
                            <template slot-scope="scope">
                                <div>
                                    <i class="fa fa-cubes"></i>
                                    {{scope.row.xncfModule.name}}
                                </div>
                                <div>
                                    <i class="fa fa-shield"></i>
                                    {{scope.row.xncfModule.uid}}
                                </div>
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.Status"]">
                            <template slot-scope="scope">
                                {{oldData.state[scope.row.xncfModule.state]}}
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Common.添加时间"]">
                            <template slot-scope="scope">
                                {{formaTableTime(scope.row.xncfModule.addTime)}}
                            </template>
                        </el-table-column>
                        <el-table-column label="@AR["Xncf.Actions"]" width="185">
                            <template slot="header" slot-scope="scope">
                                <el-input v-model="oldTableSearch"
                                            size="mini"
                                            placeholder="@AR["Xncf.Search"]" />
                            </template>
                            <template slot-scope="scope">
                                <el-button size="mini"
                                            icon="el-icon-s-tools"
                                            type="primary"
                                            v-if="scope.row.xncfRegister!==null"
                                            @@click="handleHandle(scope.$index, scope.row)">@AR["Xncf.Actions"]</el-button>
                                <el-button size="mini"
                                            v-if="scope.row.xncfRegister!==null&&scope.row.xncfRegister.homeUrl"
                                            icon="el-icon-s-home"
                                            type="primary"
                                            @@click="handleIndex(scope.$index, scope.row)">@AR["Xncf.Home"]</el-button>
                                <div v-if="scope.row.xncfRegister===null">
                                    <span>@AR["Xncf.Missing"]</span>
                                    @*  <span>
                                <el-button size="mini"
                                            icon="el-icon-s-home"
                                            type="primary"
                                            @@click="remove(scope.$index, scope.row)">@AR["Xncf.Home"]</el-button>
                            </span> *@
                                </div>
                            </template>
                        </el-table-column>
                    </el-table>
                </el-tab-pane>
                <el-tab-pane name="updates">
                    <template #label>
                        @AR["Xncf.PendingUpdates"]<sup class="el-badge__content">{{updatedTableData.length}}</sup>
                    </template>
                    <template #add-icon>
                        <el-popconfirm placement="top" :title="handlerTips" @@on-confirm="handleSwitch">
                            <el-button size="mini" type="danger" slot="reference">{{handlerText}}</el-button>
                        </el-popconfirm>
                    </template>
                    <div class="filter-container" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                        <span style="color:#606266;">{{ncfT('Xncf.BatchUpdate.SelectedCount', selectedUpdatedModules.length)}}</span>
                        <el-button type="primary"
                                   icon="el-icon-refresh"
                                   :loading="batchUpdate.loading"
                                   :disabled="selectedUpdatedModules.length === 0 || batchUpdate.loading"
                                   @@click="confirmBatchUpdate">
                            @AR["Xncf.BatchUpdateAndEnable"]
                        </el-button>
                    </div>
                    <el-table ref="updatedModulesTable"
                              :data="filteredUpdatedTableData"
                              row-key="uid"
                              @@selection-change="handleUpdatedSelectionChange"
                              style="width: 100%;margin-bottom: 20px;">
                        <el-table-column type="selection" width="48" reserve-selection></el-table-column>
                        <el-table-column align="left" label="@AR["Xncf.ModuleName"]">
                            <template slot-scope="scope">
                                <i class="fa fa-cubes"></i>
                                {{scope.row.name}}
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.MenuName"]">
                            <template slot-scope="scope">
                                <i :class="scope.row.icon"></i>
                                {{scope.row.menuName}}

                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.Version"]">
                            <template slot-scope="scope">
                                <i class="fa fa-code-fork"></i>
                                {{scope.row.version}}
                            </template>
                        </el-table-column>
                        <el-table-column align="center" label="@AR["Xncf.UniqueCode"]" width="350">
                            <template slot-scope="scope">
                                <i class="fa fa-shield"></i>
                                {{scope.row.uid}}
                            </template>
                        </el-table-column>
                        <el-table-column label="@AR["Xncf.Actions"]" width="95">
                            <template slot="header" slot-scope="scope">
                                <el-input v-model="updatedTableSearch"
                                          size="mini"
                                          placeholder="@AR["Xncf.Search"]" />
                            </template>
                            <template slot-scope="scope">
                                <el-button size="mini"
                                           type="primary"
                                           icon="el-icon-circle-plus"
                                           @@click="handleSingleUpdate(scope.row)">@AR["Xncf.UpdateNow"]</el-button>
                            </template>
                        </el-table-column>
                    </el-table>
                </el-tab-pane>
            </el-tabs>
        </el-main>
    </el-container>

    <el-dialog title="@AR["Xncf.BatchUpdateResult"]"
               :visible.sync="batchUpdate.resultVisible"
               :close-on-click-modal="false"
               width="90%">
        <template v-if="batchUpdate.result">
            <el-alert :title="ncfT('Xncf.BatchUpdate.Summary', batchUpdate.result.totalCount, batchUpdate.result.successCount, batchUpdate.result.failureCount)"
                      :type="batchUpdate.result.failureCount === 0 ? 'success' : 'warning'"
                      :closable="false"
                      show-icon>
            </el-alert>
            <el-table :data="batchUpdate.result.items"
                      style="width:100%;margin-top:16px;"
                      max-height="460">
                <el-table-column prop="moduleName" label="@AR["Xncf.ModuleName"]" min-width="145"></el-table-column>
                <el-table-column label="@AR["Xncf.BatchUpdate.VersionResult"]" min-width="165">
                    <template slot-scope="scope">
                        <div>{{scope.row.previousVersion || '-'}} → {{scope.row.finalVersion || '-'}}</div>
                        <small v-if="scope.row.finalVersion !== scope.row.targetVersion" style="color:#e6a23c;">
                            {{ncfT('Xncf.BatchUpdate.TargetVersion', scope.row.targetVersion || '-')}}
                        </small>
                    </template>
                </el-table-column>
                <el-table-column label="@AR["Xncf.BatchUpdate.UpdateStatus"]" width="105" align="center">
                    <template slot-scope="scope">
                        <el-tag :type="scope.row.updateSucceeded ? 'success' : 'danger'" size="mini">
                            {{scope.row.updateSucceeded ? ncfT('Xncf.BatchUpdate.Success') : ncfT('Xncf.BatchUpdate.Failed')}}
                        </el-tag>
                    </template>
                </el-table-column>
                <el-table-column label="@AR["Xncf.BatchUpdate.EnableStatus"]" width="105" align="center">
                    <template slot-scope="scope">
                        <el-tag :type="scope.row.enableSucceeded ? 'success' : 'danger'" size="mini">
                            {{scope.row.enableSucceeded ? ncfT('Xncf.BatchUpdate.Success') : ncfT('Xncf.BatchUpdate.Failed')}}
                        </el-tag>
                    </template>
                </el-table-column>
                <el-table-column label="@AR["Xncf.BatchUpdate.FinalState"]" width="115" align="center">
                    <template slot-scope="scope">
                        {{scope.row.finalState === null ? '-' : oldData.state[scope.row.finalState]}}
                    </template>
                </el-table-column>
                <el-table-column prop="message" label="@AR["Xncf.BatchUpdate.Details"]" min-width="220"></el-table-column>
            </el-table>
        </template>
        <span slot="footer" class="dialog-footer">
            <el-button type="primary" @@click="batchUpdate.resultVisible = false">@AR["Xncf.CloseDialog"]</el-button>
        </span>
    </el-dialog>
</div>
@section scripts {
    <script src="~/js/Admin/Pages/XncfModule/Index.js"></script>
}
