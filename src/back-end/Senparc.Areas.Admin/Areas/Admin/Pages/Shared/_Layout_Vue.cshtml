@model Senparc.Ncf.AreaBase.Admin.IAdminPageModelBase
@inject Senparc.Areas.Admin.Domain.AdminUserInfoService AdminUserInfoService
@using Senparc.Ncf.Core.Utility
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isEmbedded = string.Equals(Context.Request.Query["embedded"], "1", StringComparison.Ordinal);
    var webLoginExpireMinutes = Senparc.Areas.Admin.Domain.Models.DatabaseModel.AdminAuthConfig.DefaultAdminWebLoginExpireMinutes;
    var jwtExpireMinutes = Senparc.Areas.Admin.Domain.Models.DatabaseModel.AdminAuthConfig.DefaultBackendJwtExpireMinutes;
    var currentAccountName = !string.IsNullOrWhiteSpace(User?.Identity?.Name)
        ? User.Identity.Name
        : !string.IsNullOrWhiteSpace(Model?.AdminWorkContext?.UserName)
            ? Model.AdminWorkContext.UserName
            : !string.IsNullOrWhiteSpace(Model?.UserName)
                ? Model.UserName
                : "-";
    try
    {
        webLoginExpireMinutes = AdminUserInfoService.GetAdminWebLoginExpireMinutes();
        jwtExpireMinutes = AdminUserInfoService.GetBackendJwtExpireMinutes();
    }
    catch
    {
        // 忽略异常并回退默认值，避免布局渲染被配置异常中断。
    }
}
@inject Microsoft.Extensions.Localization.IStringLocalizer<Senparc.Areas.Admin.AdminResource> AR

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Title"]" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <link rel="shortcut icon" href="~/favicon.ico" type="image/x-icon">
    <!-- 引入样式 -->
    <link href="~/lib/element-ui_2.13.2/element.css" rel="stylesheet" />
    <link href="~/css/Admin/Shared/layout.css" rel="stylesheet" />
    <link href="~/lib/font-awesome/css/font-awesome.min.css" rel="stylesheet">
    @RenderSection("HeaderContent", false)
    @RenderSection("Style", false)
</head>
<body class="@(isEmbedded ? "ncf-admin-embedded" : null)">
    <div id="app" v-cloak>
        <div class="app-wrapper">
            <el-container class="admin-shell">
                @*菜单栏*@
                <el-aside :style="{'width':Store.state.navMenu.isCollapse?'64px':''}" class="el-aside-index">
                    <div :class="[Store.state.navMenu.isCollapse?'head-log2':'head-log']">
                        <a href="/Admin/Index">
                            <img src="~/images/Admin/base/head/logo_230x55.png" alt="@AR["Admin.Layout.LogoAlt"]" />
                        </a>
                    </div>
                    <el-scrollbar wrap-class="scrollbar-wrapper" style="height:calc(100vh - 80px);">
                        <el-menu :default-active="Store.state.navMenu.activeMenu"
                                 :default-openeds="Store.state.navMenu.openedMenus"
                                 :collapse="Store.state.navMenu.isCollapse"
                                 :background-color="Store.state.navMenu.variables.menuBg"
                                 :text-color="Store.state.navMenu.variables.menuText"
                                 :active-text-color="Store.state.navMenu.variables.menuActiveText"
                                 :unique-opened="false"
                                 :collapse-transition="false"
                                 @@select="menuSelect"
                                 @@open="menuOpen"
                                 @@close="menuClose"
                                 mode="vertical">
                            <sidebar-item v-for="(items,index) in Store.state.navMenu.navMenuList" :key="index" :item="items"></sidebar-item>
                        </el-menu>
                    </el-scrollbar>
                </el-aside>
                <el-container class="admin-workspace">
                    <el-header>
                        <div class="header-menu">
                            @*切换菜单栏*@
                            <i class="fa fa-indent" aria-hidden="true" @@click="toggleSideBar"></i>
                        </div>
                        @*面包屑*@
                        <div class="header-breadcrumb">
                            <el-breadcrumb separator="/">
                                <el-breadcrumb-item><a href="/Admin/Index">@AR["Admin.Nav.Home"]</a></el-breadcrumb-item>
                                @RenderSection("breadcrumbs", false)
                            </el-breadcrumb>
                        </div>
                        <div class="header-language">
                            <label for="ncf-lang" class="header-language-label">@AR["Admin.Language.SelectLanguage"]</label>
                            <select id="ncf-lang" class="header-language-select" onchange="ncfSwitchLanguage(this.value)">
                                <option value="zh-CN" selected="@(currentCulture == "zh-CN" ? "selected" : null)">简体中文</option>
                                <option value="en" selected="@(currentCulture.StartsWith("en") ? "selected" : null)">English</option>
                                <option value="ja" selected="@(currentCulture.StartsWith("ja") ? "selected" : null)">日本語</option>
                                <option value="fr" selected="@(currentCulture.StartsWith("fr") ? "selected" : null)">Français</option>
                                <option value="es" selected="@(currentCulture.StartsWith("es") ? "selected" : null)">Español</option>
                                <option value="ru" selected="@(currentCulture.StartsWith("ru") ? "selected" : null)">Русский</option>
                            </select>
                        </div>
                        <div class="header-account">
                            <el-dropdown trigger="click">
                                <span class="el-dropdown-link">
                                    @AR["Admin.Layout.Account"]<i class="el-icon-arrow-down el-icon--right"></i>
                                </span>
                                <el-dropdown-menu slot="dropdown" class="header-account-dropdown">
                                    <el-dropdown-item disabled>@AR["Admin.Layout.CurrentAccount", currentAccountName]</el-dropdown-item>
                                    <el-dropdown-item divided>
                                        <a class="header-account-action" asp-page="/Login" asp-page-handler="Logout">@AR["Admin.Logout.Title"]</a>
                                    </el-dropdown-item>
                                </el-dropdown-menu>
                            </el-dropdown>
                        </div>
                    </el-header>
                    <el-main class="admin-content">
                        <div class="ifram-wrapper">
                            @*<iframe :src="pageSrc"></iframe>*@
                            @RenderBody()
                        </div>
                    </el-main>
                    <el-footer class="footer" height="36px">
                        <div class="admin-footer-tools">
                            <button type="button" class="admin-footer-action" @@click="openFooterAi" title="AI 快捷对话">
                                <i class="fa fa-comments-o"></i><span>AI</span>
                            </button>
                            <button type="button" class="admin-footer-action" @@click="consoleDialogVisible = true" title="浏览器 Console">
                                <i class="fa fa-terminal"></i><span>Console</span>
                                <span class="admin-footer-badge" v-if="consoleEntries.length">{{ consoleEntries.length }}</span>
                            </button>
                            <button v-if="footerAvailabilityKnown" type="button" class="admin-footer-action" @@click="neuBellDrawerVisible = true" title="@AR["Admin.Footer.NeuBellLabel"]">
                                <i class="fa fa-bell-o"></i><span>@AR["Admin.Footer.NeuBellLabel"]</span>
                                <span class="admin-footer-badge" v-if="neuBellTotalCount">{{ neuBellTotalCount }}</span>
                            </button>
                            <button type="button" class="admin-footer-time" @@click="handleFooterTimeClick" title="服务器时间" aria-label="服务器时间">
                                <i class="fa fa-clock-o"></i> {{ serverTimeText }}
                            </button>
                        </div>
                        <div class="admin-footer-copyright">
                            @AR["Admin.Layout.PoweredBy"] <a href="https://www.ncf.pub" target="_blank" rel="noopener noreferrer">NeuCharFramework</a>
                            <span class="admin-footer-separator">·</span>
                            @Html.Raw(FooterContentSanitizer.Sanitize(Model?.FullSystemConfig?.FooterContent))
                        </div>
                    </el-footer>
                </el-container>
            </el-container>
        </div>

        <el-dialog
            title="AI 快捷对话"
            :visible.sync="footerAiDialogVisible"
            width="min(1080px, 92vw)"
            top="6vh"
            custom-class="admin-footer-ai-dialog"
            :close-on-click-modal="false">
            <div class="admin-footer-ai-frame" v-if="footerAiDialogVisible">
                <iframe :src="footerAiUrl" title="Admin Chat 快捷对话"></iframe>
            </div>
            <span slot="footer" class="dialog-footer">
                <el-button @@click="footerAiDialogVisible = false">关闭</el-button>
                <el-button type="primary" @@click="openFullAdminChat">切换到正式页面</el-button>
            </span>
        </el-dialog>

        <el-dialog
            title="浏览器 Console"
            :visible.sync="consoleDialogVisible"
            width="min(960px, 90vw)"
            custom-class="admin-footer-console-dialog">
            <div class="admin-console-toolbar">
                <span>仅显示当前页面加载后捕获的浏览器日志，不包含服务器 stdout。</span>
                <el-button size="mini" @@click="clearFooterConsole">清空</el-button>
            </div>
            <div class="admin-console-output">
                <div v-if="consoleEntries.length === 0" class="admin-console-empty">暂无日志</div>
                <div v-for="entry in consoleEntries" :key="entry.id" :class="['admin-console-line', 'is-' + entry.level]">
                    <span class="admin-console-time">{{ entry.time }}</span>
                    <span class="admin-console-level">{{ entry.level }}</span>
                    <span class="admin-console-message">{{ entry.message }}</span>
                </div>
            </div>
        </el-dialog>

        <el-drawer
            title="@AR["Admin.Footer.NeuBellLabel"]"
            :visible.sync="neuBellDrawerVisible"
            direction="rtl"
            size="380px">
            <div class="admin-neubell-panel" v-loading="neuBellLoading">
                <p class="admin-neubell-description">选择在 Footer 显示的模块提醒。设置保存在当前账号的浏览器中。</p>
                <div v-if="neuBellProviders.length === 0" class="admin-neubell-empty">当前没有模块提供纽铃信息。</div>
                <section v-for="provider in neuBellProviders" :key="provider.providerId" class="admin-neubell-provider">
                    <header>
                        <span><i :class="provider.icon"></i> {{ provider.displayName }}</span>
                        <span class="admin-neubell-provider-actions">
                            <el-button v-if="provider.canConsume"
                                       type="text"
                                       size="mini"
                                       :disabled="!provider.items || provider.items.length === 0"
                                       @@click="consumeNeuBell(provider, null, true)">消费全部</el-button>
                            <el-switch v-model="provider.enabled" @@change="saveNeuBellPreferences"></el-switch>
                        </span>
                    </header>
                    <div v-for="item in provider.items" :key="item.id" class="admin-neubell-item">
                        <a :href="item.detailUrl" class="admin-neubell-item-link">
                            <span class="admin-neubell-item-content">
                                <strong>{{ item.title }}</strong>
                                <small>{{ item.summary }}</small>
                            </span>
                            <el-badge :value="item.count" :hidden="!item.count" :type="item.severity === 'warning' ? 'warning' : 'primary'"></el-badge>
                        </a>
                        <el-button v-if="provider.canConsume" type="text" size="mini" @@click="consumeNeuBell(provider, item, false)">消费</el-button>
                    </div>
                </section>
            </div>
        </el-drawer>

        <section v-if="neuBellToastEntries.length"
                 :class="['admin-neubell-toast-stack', { 'is-expanded': neuBellToastExpanded }]"
                 aria-live="polite"
                 aria-label="NeuBell 提醒">
            <header class="admin-neubell-toast-toolbar">
                <span><i class="fa fa-bell-o"></i> NeuBell 提醒</span>
                <button type="button" class="admin-neubell-toast-clear" @@click="clearAllNeuBellToasts">关闭全部</button>
            </header>
            <div class="admin-neubell-toast-list">
                <button v-for="entry in neuBellToastVisibleItems"
                        :key="entry.key"
                        type="button"
                        class="admin-neubell-toast-card"
                        @@click="openNeuBellToast(entry)">
                    <span class="admin-neubell-toast-icon"><i :class="entry.providerIcon || 'fa fa-bell-o'"></i></span>
                    <span class="admin-neubell-toast-content">
                        <strong>{{ entry.item.title || entry.providerName || 'NeuBell' }}</strong>
                        <small>{{ entry.item.summary }}</small>
                    </span>
                    <i class="el-icon-arrow-right admin-neubell-toast-arrow"></i>
                </button>
            </div>
            <button v-if="neuBellToastOverflowCount"
                    type="button"
                    class="admin-neubell-toast-expand"
                    @@click="toggleNeuBellToastExpanded">
                {{ neuBellToastExpanded ? '收起' : '还有 ' + neuBellToastOverflowCount + ' 条，点击展开' }}
            </button>
        </section>
    </div>
    @Html.AntiForgeryToken()
    <!--lib-->
    <script src="~/lib/vue/vue.js"></script>
    <script src="~/lib/element-ui_2.13.2/element.js"></script>
    <script src="~/lib/axios/axios.min.js"></script>
    <script src="~/lib/vuex.js"></script>
    @await Html.PartialAsync("_LocalizationScripts")
    <!--js-->
    <script src="~/js/Admin/store.js"></script>
    <script src="~/js/Admin/axios.js" asp-append-version="true"></script>
    <script src="~/js/Admin/global.js"></script>
    <!--菜单栏-->
    <script src="~/js/Admin/navMenu.js"></script>
    <script src="~/js/Admin/vuePermission.js"></script>
    <script src="~/js/Admin/Pages/Components/Components.js"></script>
    <script>
        window.NCF_ADMIN_FOOTER_INITIAL_STATE = {
            serverTime: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(DateTimeOffset.Now)),
            account: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentAccountName)),
            embedded: @(isEmbedded ? "true" : "false")
        };
    </script>
    <script src="~/js/Admin/Shared/AdminFooter.js" asp-append-version="true"></script>
    <!--页面js-->
    @*<script src="~/js/Admin/Pages/Index/Index.js"></script>*@
    @RenderSection("scripts", false)
    <script>
        window.NCF_SESSION_CONFIG = {
            webLoginExpireMinutes: @webLoginExpireMinutes,
            jwtExpireMinutes: @jwtExpireMinutes,
            remindBeforeMinutes: 5
        };
        window.NCF_SESSION_I18N = {
            title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AR["Admin.Session.Title"].Value)),
            message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AR["Admin.Session.Message"].Value)),
            keepLogin: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AR["Admin.Session.KeepLogin"].Value)),
            logoutNow: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AR["Admin.Session.LogoutNow"].Value)),
            keepLoginSuccess: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AR["Admin.Session.KeepLoginSuccess"].Value))
        };
        if (typeof window.ncfStartSessionMonitor === 'function') {
            window.ncfStartSessionMonitor();
        }
    </script>
</body>
</html>
