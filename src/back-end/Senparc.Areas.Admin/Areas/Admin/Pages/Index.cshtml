@page

@model Senparc.Areas.Admin.Pages.IndexModel
@{
    ViewData["Title"] = AR["Admin.Title"];
    Layout = "_Layout_Vue";
}
@section style {
    <link rel="stylesheet" href="~/css/Admin/Pages/AdminChat/ChatLauncher.css" asp-append-version="true" />
    <style>
        #home-header .el-main {
            padding: 20px 10px 0px 10px;
            height: auto;
        }

        .host-metrics-section {
            margin: 20px 10px 0;
        }

        .host-metrics-card {
            border-radius: 10px;
        }

        .host-metrics-header,
        .host-metrics-title,
        .host-metrics-status {
            display: flex;
            align-items: center;
        }

        .host-metrics-header {
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .host-metrics-title {
            gap: 9px;
            font-size: 17px;
            font-weight: 600;
            color: #303133;
        }

        .host-metrics-title .fa {
            color: #8c52ff;
        }

        .host-metrics-status {
            gap: 10px;
            color: #909399;
            font-size: 12px;
        }

        .host-live-indicator {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #67c23a;
        }

        .host-live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #67c23a;
            box-shadow: 0 0 0 rgba(103, 194, 58, 0.4);
            animation: host-live-pulse 1.8s infinite;
        }

        @@keyframes host-live-pulse {
            0% { box-shadow: 0 0 0 0 rgba(103, 194, 58, 0.45); }
            70% { box-shadow: 0 0 0 7px rgba(103, 194, 58, 0); }
            100% { box-shadow: 0 0 0 0 rgba(103, 194, 58, 0); }
        }

        .host-metrics-meta {
            margin-bottom: 12px;
            color: #909399;
            font-size: 12px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .host-metric-item {
            min-height: 148px;
            margin-bottom: 14px;
            padding: 17px;
            border: 1px solid #ebeef5;
            border-radius: 9px;
            background: linear-gradient(145deg, #ffffff 0%, #fafbff 100%);
            box-sizing: border-box;
        }

        .host-metric-label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
            color: #606266;
            font-size: 14px;
        }

        .host-metric-label .fa {
            color: #8c52ff;
            font-size: 18px;
        }

        .host-metric-value {
            min-height: 39px;
            color: #303133;
            font-size: 27px;
            font-weight: 600;
            line-height: 1.35;
        }

        .host-metric-value.host-network-value {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            font-size: 17px;
            line-height: 2.1;
        }

        .host-metric-readings {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            align-items: baseline;
            gap: 14px;
            min-height: 38px;
        }

        .host-metric-reading {
            display: flex;
            align-items: baseline;
            min-width: 0;
            gap: 7px;
            white-space: nowrap;
        }

        .host-metric-reading + .host-metric-reading {
            justify-content: flex-end;
        }

        .host-metric-scope {
            display: inline-flex;
            align-items: center;
            flex: 0 0 auto;
            gap: 5px;
            color: #909399;
            font-size: 12px;
        }

        .host-metric-scope-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

        .host-metric-scope-dot.cpu-host {
            background: #8c52ff;
        }

        .host-metric-scope-dot.memory-host {
            background: #67c23a;
        }

        .host-metric-scope-dot.web-process {
            background: #00a6a6;
        }

        .host-metric-reading-value {
            overflow: hidden;
            color: #303133;
            font-size: 24px;
            font-weight: 600;
            line-height: 1.35;
            text-overflow: ellipsis;
        }

        .host-metric-reading.web-process .host-metric-reading-value {
            color: #008f8f;
            font-size: 18px;
        }

        .host-comparison-bar {
            position: relative;
            height: 9px;
            margin-top: 11px;
            overflow: hidden;
            border-radius: 5px;
            background: #ebeef5;
        }

        .host-comparison-bar-fill {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            transition: width 0.35s ease;
        }

        .host-comparison-bar-fill.cpu-host {
            background: linear-gradient(90deg, #a172ff 0%, #8c52ff 100%);
        }

        .host-comparison-bar-fill.memory-host {
            background: linear-gradient(90deg, #85ce61 0%, #67c23a 100%);
        }

        .host-comparison-bar-fill.web-process {
            z-index: 1;
            background: #00a6a6;
            box-shadow: 1px 0 0 rgba(255, 255, 255, 0.75);
        }

        .host-comparison-bar-fill.web-process.has-value {
            min-width: 3px;
        }

        .host-network-down {
            color: #409eff;
        }

        .host-network-up {
            color: #e6a23c;
        }

        .host-metric-detail {
            margin-top: 8px;
            color: #909399;
            font-size: 12px;
            line-height: 1.55;
        }

        .host-metrics-chart {
            height: 285px;
            margin-top: 4px;
        }

        .host-metrics-error {
            color: #f56c6c;
        }

        @@media screen and (max-width: 768px) {
            .host-metrics-section {
                margin-left: 0;
                margin-right: 0;
            }

            .host-metric-value.host-network-value {
                flex-direction: column;
                gap: 0;
                line-height: 1.6;
            }
        }

        .agents-overview-section {
            margin: 20px 10px 0;
        }

        .agents-overview-card {
            overflow: hidden;
            border: 1px solid #e7e0ff;
            border-radius: 12px;
            background: linear-gradient(135deg, #fbfaff 0%, #ffffff 58%, #f7fffc 100%);
        }

        .agents-overview-header,
        .agents-overview-title,
        .agents-overview-actions,
        .agents-overview-live,
        .agents-overview-status-item {
            display: flex;
            align-items: center;
        }

        .agents-overview-header {
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .agents-overview-title {
            gap: 10px;
            color: #303133;
            font-size: 17px;
            font-weight: 600;
        }

        .agents-overview-title .fa {
            color: #7c3aed;
        }

        .agents-overview-actions {
            gap: 12px;
        }

        .agents-overview-live {
            gap: 6px;
            color: #909399;
            font-size: 12px;
        }

        .agents-overview-live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #67c23a;
            box-shadow: 0 0 0 rgba(103, 194, 58, .4);
            animation: host-live-pulse 1.8s infinite;
        }

        .agents-overview-metric {
            min-height: 132px;
            padding: 17px;
            margin-bottom: 14px;
            border: 1px solid #ece9f8;
            border-radius: 10px;
            background: rgba(255, 255, 255, .82);
            box-sizing: border-box;
        }

        .agents-overview-metric.is-published {
            border-color: #f9ddb1;
            background: linear-gradient(145deg, #fffdfa 0%, #fff8e9 100%);
        }

        .agents-overview-metric.is-remote {
            border-color: #c7e9e2;
            background: linear-gradient(145deg, #fbfffe 0%, #effbf8 100%);
        }

        .agents-overview-metric.is-group {
            border-color: #dce8fb;
            background: linear-gradient(145deg, #fcfdff 0%, #f0f6ff 100%);
        }

        .agents-overview-metric-label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            color: #606266;
            font-size: 14px;
        }

        .agents-overview-metric-label .fa {
            color: #8c52ff;
            font-size: 18px;
        }

        .agents-overview-metric.is-published .agents-overview-metric-label .fa { color: #e6a23c; }
        .agents-overview-metric.is-remote .agents-overview-metric-label .fa { color: #0f9d8a; }
        .agents-overview-metric.is-group .agents-overview-metric-label .fa { color: #409eff; }

        .agents-overview-metric-value {
            margin: 9px 0 5px;
            color: #303133;
            font-size: 30px;
            font-weight: 650;
            line-height: 1.15;
        }

        .agents-overview-metric-meta {
            color: #909399;
            font-size: 12px;
            line-height: 1.55;
        }

        .agents-overview-status-strip {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
            padding: 12px;
            border-radius: 10px;
            background: #312e4d;
            color: #f5f3ff;
        }

        .agents-overview-status-item {
            min-width: 0;
            gap: 9px;
            padding: 3px 6px;
        }

        .agents-overview-status-item .fa {
            color: #c4b5fd;
        }

        .agents-overview-status-value {
            display: block;
            color: #fff;
            font-size: 18px;
            font-weight: 600;
            line-height: 1.1;
        }

        .agents-overview-status-label {
            display: block;
            margin-top: 2px;
            overflow: hidden;
            color: #d8d4fe;
            font-size: 12px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .xncf-stat-item {
            position: relative;
            display: block;
            margin-bottom: 10px;
            border: 1px solid #E4E4E4;
            overflow: hidden;
            padding-bottom: 5px;
            border-radius: 5px;
            background-clip: padding-box;
            background: #FFF;
            transition: all 300ms ease-in-out;
            padding-left: 10px;
            height: 120px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .xncf-stat-item .icon {
                font-size: 45px;
                color: #BAB8B8;
                position: absolute;
                right: 20px;
                top: 50%;
                transform: translateY(-50%);
            }

            .xncf-stat-item .count {
                font-size: 32px;
                font-weight: bold;
                line-height: 1.65857;
            }

            .xncf-stat-item .tit {
                color: #BAB8B8;
                font-size: 18px;
            }

            .xncf-stat-item p {
                margin-bottom: 5px;
            }

        .chart-title {
            font-size: 20px;
        }

        .chart-li {
            padding-top: 20px;
        }

            .chart-li li {
                line-height: 2;
            }

            .chart-li .fa {
                margin-right: 5px;
            }

        .box-card {
            margin-top: 20px
        }

            .box-card:hover {
                border-color: purple; /* 外框颜色 */
                box-shadow: 0 0 10px rgba(128, 0, 128, 0.5); /* 发光阴影颜色 */
            }

        /* 右侧图表区域卡片样式覆盖 */
        .el-main .el-col-16 .box-card {
            margin-top: 0;
        }

        #xncf-modules-area {
            margin-bottom: 50px;
        }

            #xncf-modules-area .xncf-item {
            }

                #xncf-modules-area .xncf-item .version {
                    float: right;
                }

                #xncf-modules-area .xncf-item .icon {
                    float: left;
                }

                /* 模块卡片样式优化 */
                #xncf-modules-area .xncf-item .box-card {
                    height: 160px;
                    transition: all 0.3s ease;
                    cursor: pointer;
                }

                    #xncf-modules-area .xncf-item .box-card:hover {
                        transform: translateY(-5px);
                        border-color: #8c52ff;
                        box-shadow: 0 5px 15px rgba(140, 82, 255, 0.2);
                    }

        /* 模块图标样式优化 */
        .component-item {
            display: flex;
            align-items: center;
            padding: 15px;
            height: 100%;
        }

            .component-item .icon {
                font-size: 40px;
                color: #8c52ff;
                transition: all 0.3s ease;
                margin-right: 15px;
                flex-shrink: 0;
            }

            .component-item .description {
                flex: 1;
                font-size: 13px;
                color: #666;
                overflow: hidden;
                text-overflow: ellipsis;
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                line-height: 1.5;
            }



        #xncf-modules-area .xncf-item .box-card:hover .icon {
            transform: scale(1.1);
        }



        /* 版本号样式优化 */
        #xncf-modules-area .xncf-item .version {
            background: #f0f2f5;
            padding: 2px 6px;
            border-radius: 10px;
            font-size: 12px;
            color: #666;
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
        }

            /* 可升级版本的样式 */
            #xncf-modules-area .xncf-item .version.version-upgradeable {
                background: #e6f1fc;
                color: #409EFF;
                border: 1px solid #b3d8ff;
            }

        .version-upgrade-icon {
            color: #409EFF;
            margin-left: 4px;
            font-size: 14px;
        }

        /* 模块名称样式 */
        .xncf-item .el-card__header {
            padding: 10px 15px;
        }

        /* 响应式布局优化 */
        @@media screen and (max-width: 1200px) {
            #xncf-modules-area .el-col-6 {
                width: 33.33%;
            }
        }

        @@media screen and (max-width: 768px) {
            #xncf-modules-area .el-col-6 {
                width: 50%;
            }
        }

        @@media screen and (max-width: 480px) {
            #xncf-modules-area .el-col-6 {
                width: 100%;
            }
        }

        /* 图表容器样式 */
        .charts-container {
            height: 260px;
        }

        /* 针对包含charts-container的卡片内容区域移除内边距 */
        .el-card__body .charts-container {
            margin-bottom: -40px; /* 抵消父元素的padding，底部有足够留白 */
        }

        /* 添加更强烈的抖动动画关键帧 */
        @@keyframes shake {
            0%, 100% {
                transform: translateX(0) rotate(0deg);
            }

            15% {
                transform: translateX(-8px) rotate(-2deg);
            }

            30% {
                transform: translateX(6px) rotate(1.5deg);
            }

            45% {
                transform: translateX(-4px) rotate(-0.5deg);
            }

            60% {
                transform: translateX(2px) rotate(0.25deg);
            }

            75% {
                transform: translateX(-1px) rotate(-0.125deg);
            }
        }

        /* 添加发光动画关键帧 */
        @@keyframes glow {
            0%, 100% {
                box-shadow: 0 0 5px rgba(140, 82, 255, 0.2);
                transform: scale(1);
            }

            50% {
                box-shadow: 0 0 20px rgba(140, 82, 255, 0.6);
                transform: scale(1.02);
            }
        }

        /* 添加淡化效果动画 */
        @@keyframes fade {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0.6;
            }
        }

        /* 动画类 */
        .shake-animation {
            animation: shake 0.8s cubic-bezier(.36,.07,.19,.97) both;
        }

        .glow-animation {
            animation: glow 1.2s ease-in-out;
        }

        .fade-animation {
            animation: fade 1.2s ease-in-out;
        }

        /* AI 对话入口样式 */
        #ai-chat-entrance .chat-entrance-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 15px;
            overflow: hidden;
        }

        .chat-entrance-container {
            color: #fff;
        }

        .chat-entrance-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }

        .chat-entrance-icon {
            font-size: 50px;
            margin-right: 20px;
            opacity: 0.9;
        }

        .chat-entrance-content {
            flex: 1;
        }

        .chat-entrance-title {
            margin: 0 0 8px 0;
            font-size: 24px;
            font-weight: 600;
            color: #fff;
        }

            .chat-entrance-title .fa {
                margin-right: 8px;
            }

        .chat-entrance-subtitle {
            margin: 0;
            font-size: 14px;
            opacity: 0.9;
        }

        .chat-entrance-input-wrapper {
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .chat-entrance-input .el-textarea__inner {
            background: rgba(255, 255, 255, 0.95);
            border: none;
            border-radius: 15px;
            padding: 15px 20px;
            font-size: 15px;
            line-height: 1.6;
            resize: none;
        }

            .chat-entrance-input .el-textarea__inner:focus {
                background: rgba(255, 255, 255, 1);
                box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.3);
            }

            .chat-entrance-input .el-textarea__inner::placeholder {
                color: #999;
                line-height: 1.6;
            }

        .chat-send-button {
            align-self: flex-end;
            border-radius: 25px;
            padding: 12px 30px;
            font-weight: 600;
            background: linear-gradient(135deg, #5e72e4 0%, #825ee4 100%);
            border: none;
            color: #fff;
            transition: all 0.3s ease;
        }

            .chat-send-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(94, 114, 228, 0.4);
            }

            .chat-send-button:active {
                transform: translateY(0);
            }

        .chat-entrance-tips {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 20px;
        }

        .tip-item {
            font-size: 13px;
            opacity: 0.85;
        }

            .tip-item .fa {
                margin-right: 5px;
            }

        .chat-module-drop-zone {
            background: rgba(255, 255, 255, 0.1);
            border: 2px dashed rgba(255, 255, 255, 0.3);
            border-radius: 10px;
            min-height: 100px;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            margin-top: 15px;
        }

            .chat-module-drop-zone.drag-over {
                background: rgba(255, 255, 255, 0.2);
                border-color: rgba(255, 255, 255, 0.8);
                border-style: solid;
                border-width: 3px;
            }

        .drop-zone-placeholder {
            text-align: center;
            opacity: 0.7;
            color: #fff;
        }

            .drop-zone-placeholder .fa {
                font-size: 28px;
                margin-bottom: 8px;
                display: block;
            }

            .drop-zone-placeholder p {
                margin: 0;
                font-size: 14px;
            }

        .selected-modules-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            width: 100%;
        }

        #xncf-modules-area .xncf-item.dragging {
            opacity: 0.5;
        }

        .chat-module-drop-zone.highlight {
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.9);
            border-style: solid;
            border-width: 3px;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.4);
            transform: scale(1.02);
        }
        
        /* 拖拽时的鼠标样式 */
        #xncf-modules-area .xncf-item[draggable="true"] {
            cursor: grab;
        }
        
        #xncf-modules-area .xncf-item[draggable="true"]:active {
            cursor: grabbing;
        }

        .quick-ai-entrance {
            margin: 20px 10px 30px;
        }

        .quick-ai-card {
            border: 0;
            border-radius: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            overflow: hidden;
        }

        .quick-ai-content {
            display: flex;
            align-items: center;
            gap: 16px;
            color: #fff;
            cursor: pointer;
            outline: none;
        }

        .quick-ai-content:focus-visible {
            border-radius: 8px;
            box-shadow: 0 0 0 3px rgba(255, 255, 255, .8);
        }

        .quick-ai-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(255, 255, 255, .16);
            font-size: 25px;
        }

        .quick-ai-copy {
            flex: 1;
            min-width: 0;
        }

        .quick-ai-title {
            margin: 0 0 4px;
            color: #fff;
            font-size: 17px;
            font-weight: 600;
        }

        .quick-ai-description {
            margin: 0;
            color: rgba(255, 255, 255, .88);
            font-size: 13px;
            line-height: 1.5;
        }

        @@media screen and (max-width: 768px) {
            .agents-overview-section,
            .quick-ai-entrance {
                margin-left: 0;
                margin-right: 0;
            }

            .agents-overview-status-strip {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .agents-overview-actions {
                width: 100%;
                justify-content: space-between;
            }

            .quick-ai-content {
                align-items: flex-start;
            }

            .quick-ai-content .el-button {
                align-self: flex-end;
            }
        }
    </style>
}

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf

<!-- 统计数据 -->
<div id="home-header">
    <el-container>
        <el-header class="module-header">
            <span class="start-title"><span class="module-header-v">@AR["Admin.Home.Header"]</span></span>
        </el-header>
        <el-main>
            <el-row :gutter="20">
                <!-- 左侧统计数据 2x2 布局 -->
                <el-col :span="8">
                    <el-row :gutter="10">
                        <!-- 第一行 -->
                        <el-col :span="12">
                            <a href="~/Admin/XncfModule/Index?tab=installed">
                                <div class="grid-content xncf-stat-item">
                                    <span class="count">{{xncfStat.installedXncfCount || 0}}</span>
                                    <div class="icon">
                                        <i class="fa fa-caret-square-o-right"></i>
                                    </div>
                                    <p class="tit">@AR["Admin.Home.InstalledModules"]</p>
                                </div>
                            </a>
                        </el-col>
                        <el-col :span="12">
                            <a href="~/Admin/XncfModule/Index?tab=updates">
                                <div class="grid-content xncf-stat-item">
                                    <span class="count">{{xncfStat.updateVersionXncfCount || 0}}</span>
                                    <div class="icon">
                                        <i class="fa fa-comments-o"></i>
                                    </div>
                                    <p class="tit">@AR["Admin.Home.PendingUpdates"]</p>
                                </div>
                            </a>
                        </el-col>
                        <!-- 第二行 -->
                        <el-col :span="12">
                            <a href="~/Admin/XncfModule/Index?tab=new">
                                <div class="grid-content xncf-stat-item">
                                    <span class="count">{{xncfStat.newXncfCount || 0}}</span>
                                    <div class="icon">
                                        <i class="fa fa-sort-amount-desc"></i>
                                    </div>
                                    <p class="tit">@AR["Admin.Home.NewModules"]</p>
                                </div>
                            </a>
                        </el-col>
                        <el-col :span="12">
                            <a href="~/Admin/XncfModule/Index?tab=installed">
                                <div class="grid-content xncf-stat-item">
                                    <span class="count">{{xncfStat.missingXncfCount || 0}}</span>
                                    <div class="icon">
                                        <i class="fa fa-check-square-o"></i>
                                    </div>
                                    <p class="tit">@AR["Admin.Home.ModuleErrors"]</p>
                                </div>
                            </a>
                        </el-col>
                    </el-row>
                </el-col>

                <!-- 右侧图表区域 -->
                <el-col :span="16">
                    <el-row :gutter="20">
                        <el-col :span="12">
                            <el-card class="box-card">
                                <div id="firstChart" class="charts-container"></div>
                            </el-card>
                        </el-col>
                        <el-col :span="12">
                            <el-card class="box-card">
                                <div id="secondChart" class="charts-container"></div>
                            </el-card>
                        </el-col>
                    </el-row>
                </el-col>
            </el-row>
        </el-main>
    </el-container>
</div>

<!-- AgentsManager 已安装并启用时才展示；数据由模块的轻量概览接口提供。 -->
<section v-if="agentsOverview.available" class="agents-overview-section">
    <el-card class="agents-overview-card" v-loading="agentsOverviewLoading">
        <div slot="header" class="agents-overview-header">
            <div class="agents-overview-title">
                <i class="fa fa-sitemap"></i>
                <span>@AR["Admin.Home.AgentsOverview"]</span>
            </div>
            <div class="agents-overview-actions">
                <span class="agents-overview-live">
                    <i class="agents-overview-live-dot"></i>
                    @AR["Admin.Home.AgentsOverviewLive"] {{ agentsOverviewUpdatedText() }}
                </span>
                <el-button size="mini" type="primary" plain icon="el-icon-s-operation" @@click="navigateToAgentsManager">
                    @AR["Admin.Home.AgentsManage"]
                </el-button>
            </div>
        </div>

        <el-row :gutter="14">
            <el-col :xs="24" :sm="12" :lg="6">
                <div class="agents-overview-metric">
                    <div class="agents-overview-metric-label"><span>@AR["Admin.Home.AgentsTotal"]</span><i class="fa fa-user-circle-o"></i></div>
                    <div class="agents-overview-metric-value">{{ agentsTotal() }}</div>
                    <div class="agents-overview-metric-meta">
                        @AR["Admin.Home.AgentsLocal"] {{ agentsOverview.localAgentCount }} · @AR["Admin.Home.AgentsRemoteA2A"] {{ agentsOverview.remoteA2AAgentCount }}<br />
                        @AR["Admin.Home.AgentsEnabled"] {{ agentsEnabledTotal() }} · @AR["Admin.Home.AgentsDisabled"] {{ agentsDisabledTotal() }}
                    </div>
                </div>
            </el-col>
            <el-col :xs="24" :sm="12" :lg="6">
                <div class="agents-overview-metric is-published">
                    <div class="agents-overview-metric-label"><span>@AR["Admin.Home.AgentsPublishedA2A"]</span><i class="fa fa-share-alt"></i></div>
                    <div class="agents-overview-metric-value">{{ agentsOverview.publishedA2AAgentEnabledCount }}</div>
                    <div class="agents-overview-metric-meta">
                        @AR["Admin.Home.AgentsConfigured"] {{ agentsOverview.publishedA2AAgentCount }}<br />
                        @AR["Admin.Home.AgentsDisabled"] {{ disabledCount(agentsOverview.publishedA2AAgentCount, agentsOverview.publishedA2AAgentEnabledCount) }}
                    </div>
                </div>
            </el-col>
            <el-col :xs="24" :sm="12" :lg="6">
                <div class="agents-overview-metric is-remote">
                    <div class="agents-overview-metric-label"><span>@AR["Admin.Home.AgentsRemoteA2A"]</span><i class="fa fa-exchange"></i></div>
                    <div class="agents-overview-metric-value">{{ agentsOverview.remoteA2AAgentCount }}</div>
                    <div class="agents-overview-metric-meta">
                        @AR["Admin.Home.AgentsEnabled"] {{ agentsOverview.remoteA2AAgentEnabledCount }} · @AR["Admin.Home.AgentsDisabled"] {{ disabledCount(agentsOverview.remoteA2AAgentCount, agentsOverview.remoteA2AAgentEnabledCount) }}<br />
                        @AR["Admin.Home.AgentsActive"] {{ agentsOverview.activeRemoteA2AAgentCount }}
                    </div>
                </div>
            </el-col>
            <el-col :xs="24" :sm="12" :lg="6">
                <div class="agents-overview-metric is-group">
                    <div class="agents-overview-metric-label"><span>@AR["Admin.Home.AgentsGroups"]</span><i class="fa fa-users"></i></div>
                    <div class="agents-overview-metric-value">{{ agentsOverview.groupCount }}</div>
                    <div class="agents-overview-metric-meta">
                        @AR["Admin.Home.AgentsEnabled"] {{ agentsOverview.groupEnabledCount }} · @AR["Admin.Home.AgentsDisabled"] {{ disabledCount(agentsOverview.groupCount, agentsOverview.groupEnabledCount) }}<br />
                        @AR["Admin.Home.AgentsActive"] {{ agentsOverview.activeGroupCount }} · @AR["Admin.Home.AgentsChatting"] {{ agentsOverview.chattingGroupCount }}
                    </div>
                </div>
            </el-col>
        </el-row>

        <div class="agents-overview-status-strip">
            <div class="agents-overview-status-item"><i class="fa fa-bolt"></i><span><strong class="agents-overview-status-value">{{ agentsActiveTotal() }}</strong><small class="agents-overview-status-label">@AR["Admin.Home.AgentsActive"]</small></span></div>
            <div class="agents-overview-status-item"><i class="fa fa-comments"></i><span><strong class="agents-overview-status-value">{{ agentsChattingTotal() }}</strong><small class="agents-overview-status-label">@AR["Admin.Home.AgentsChatting"]</small></span></div>
            <div class="agents-overview-status-item"><i class="fa fa-tasks"></i><span><strong class="agents-overview-status-value">{{ agentsOverview.activeTaskCount }}</strong><small class="agents-overview-status-label">@AR["Admin.Home.AgentsActiveTasks"]</small></span></div>
            <div class="agents-overview-status-item"><i class="fa fa-pause-circle-o"></i><span><strong class="agents-overview-status-value">{{ agentsOverview.waitingOrPausedTaskCount }}</strong><small class="agents-overview-status-label">@AR["Admin.Home.AgentsWaitingOrPaused"]</small></span></div>
        </div>
    </el-card>
</section>

<!-- 当前 Host 实时指标：只在浏览器内保留最近 30 个采样点，不写入服务端缓存 -->
<div class="host-metrics-section">
    <el-card class="host-metrics-card" v-loading="hostMetricsLoading && !hostMetrics.sampledAt">
        <div slot="header" class="host-metrics-header">
            <div class="host-metrics-title">
                <i class="fa fa-tachometer"></i>
                <span>@AR["Admin.Home.HostMetrics"]</span>
            </div>
            <div class="host-metrics-status">
                <span v-if="hostMetricsError" class="host-metrics-error">
                    <i class="fa fa-exclamation-circle"></i> {{hostMetricsError}}
                </span>
                <span v-else class="host-live-indicator">
                    <i class="host-live-dot"></i>
                    @AR["Admin.Home.HostMetricsRealtime"]
                </span>
                <span v-if="hostMetrics.sampledAt">{{formatSampleTime(hostMetrics.sampledAt)}}</span>
            </div>
        </div>

        <div class="host-metrics-meta" v-if="hostMetrics.hostName">
            <i class="fa fa-server"></i>
            {{hostMetrics.hostName}} · {{hostMetrics.operatingSystem}}
        </div>

        <el-row :gutter="14">
            <el-col :xs="24" :sm="12" :lg="8">
                <div class="host-metric-item">
                    <div class="host-metric-label">
                        <span>CPU</span>
                        <i class="fa fa-microchip"></i>
                    </div>
                    <div class="host-metric-readings">
                        <div class="host-metric-reading">
                            <span class="host-metric-scope">
                                <i class="host-metric-scope-dot cpu-host"></i>@AR["Admin.Home.HostScope"]
                            </span>
                            <span class="host-metric-reading-value">{{formatPercent(hostMetrics.cpuUsagePercent)}}</span>
                        </div>
                        <div class="host-metric-reading web-process">
                            <span class="host-metric-scope">
                                <i class="host-metric-scope-dot web-process"></i>@AR["Admin.Home.WebScope"]
                            </span>
                            <span class="host-metric-reading-value">{{formatPercent(hostMetrics.processCpuUsagePercent)}}</span>
                        </div>
                    </div>
                    <div class="host-comparison-bar">
                        <span class="host-comparison-bar-fill cpu-host"
                              :style="{ width: barWidth(hostMetrics.cpuUsagePercent) }"></span>
                        <span class="host-comparison-bar-fill web-process"
                              :class="{ 'has-value': boundedSubsetPercent(hostMetrics.processCpuUsagePercent, hostMetrics.cpuUsagePercent) > 0 }"
                              :style="{ width: boundedSubsetWidth(hostMetrics.processCpuUsagePercent, hostMetrics.cpuUsagePercent) }"></span>
                    </div>
                </div>
            </el-col>

            <el-col :xs="24" :sm="12" :lg="8">
                <div class="host-metric-item">
                    <div class="host-metric-label">
                        <span>@AR["Admin.Home.HostMemory"]</span>
                        <i class="fa fa-hdd-o"></i>
                    </div>
                    <div class="host-metric-readings">
                        <div class="host-metric-reading">
                            <span class="host-metric-scope">
                                <i class="host-metric-scope-dot memory-host"></i>@AR["Admin.Home.HostScope"]
                            </span>
                            <span class="host-metric-reading-value">{{formatPercent(hostMetrics.memoryUsagePercent)}}</span>
                        </div>
                        <div class="host-metric-reading web-process">
                            <span class="host-metric-scope">
                                <i class="host-metric-scope-dot web-process"></i>@AR["Admin.Home.WebScope"]
                            </span>
                            <span class="host-metric-reading-value">{{formatBytes(hostMetrics.processWorkingSetBytes)}}</span>
                        </div>
                    </div>
                    <div class="host-comparison-bar">
                        <span class="host-comparison-bar-fill memory-host"
                              :style="{ width: barWidth(hostMetrics.memoryUsagePercent) }"></span>
                        <span class="host-comparison-bar-fill web-process"
                              :class="{ 'has-value': processMemoryPercent() > 0 }"
                              :style="{ width: boundedSubsetWidth(processMemoryPercent(), hostMetrics.memoryUsagePercent) }"></span>
                    </div>
                    <div class="host-metric-detail">
                        {{formatBytes(hostMetrics.memoryUsedBytes)}} / {{formatBytes(hostMetrics.memoryTotalBytes)}}
                        · @AR["Admin.Home.HostMemoryAvailable"] {{formatBytes(hostMetrics.memoryAvailableBytes)}}
                    </div>
                </div>
            </el-col>

            <el-col :xs="24" :sm="24" :lg="8">
                <div class="host-metric-item">
                    <div class="host-metric-label">
                        <span>@AR["Admin.Home.HostNetwork"]</span>
                        <i class="fa fa-exchange"></i>
                    </div>
                    <div class="host-metric-value host-network-value">
                        <span class="host-network-down">↓ {{formatRate(hostMetrics.networkReceiveBytesPerSecond)}}</span>
                        <span class="host-network-up">↑ {{formatRate(hostMetrics.networkSendBytesPerSecond)}}</span>
                    </div>
                    <div class="host-metric-detail">
                        @AR["Admin.Home.HostNetworkTotal"] ↓ {{formatBytes(hostMetrics.networkReceiveTotalBytes)}}
                        / ↑ {{formatBytes(hostMetrics.networkSendTotalBytes)}}
                        · {{hostMetrics.networkInterfaceCount || 0}} @AR["Admin.Home.HostInterfaces"]
                    </div>
                </div>
            </el-col>
        </el-row>

        <div id="hostMetricsChart" class="host-metrics-chart"></div>
    </el-card>
</div>

<!-- AI 对话使用 Footer 的弹出会话，首页仅保留紧凑入口，避免挤占运行概览。 -->
<section id="ai-chat-entrance" class="quick-ai-entrance">
    <el-card class="quick-ai-card" :body-style="{ padding: '18px 22px' }">
        <div class="quick-ai-content" role="button" tabindex="0" @@click="openFooterAi" @@keydown.enter.prevent="openFooterAi" @@keydown.space.prevent="openFooterAi">
            <span class="quick-ai-icon"><i class="fa fa-comments"></i></span>
            <div class="quick-ai-copy">
                <h3 class="quick-ai-title">@AR["Admin.Home.AiTitle"]</h3>
                <p class="quick-ai-description">@AR["Admin.Home.AiQuickDescription"]</p>
            </div>
            <el-button type="primary" plain icon="el-icon-chat-dot-round" @@click.stop="openFooterAi">@AR["Admin.Home.AiQuickDialog"]</el-button>
        </div>
    </el-card>
</section>

<!-- 功能模块 -->
<div>
    <el-row>
        <el-card class="box-card">
            <div slot="header" class="clearfix">
                <span><i class="fa fa-cubes"></i> @AR["Admin.Home.FeatureModules"]</span>
            </div>
            <div id="xncf-modules-area">
                <el-row :gutter="20">
                    <el-col :span="6" class="xncf-item" v-for="item in xncfOpeningList" :key="item.uid">

                        <el-card class="box-card">
                            <div slot="header" class="clearfix">
                                <span>{{item.menuName}}</span>
                                <span class="version version-container" :class="{ 'version-upgradeable': item.hasNewVersion }">
                                    v{{item.version}}
                                    <el-tooltip v-if="item.hasNewVersion"
                                                class="version-tooltip"
                                                effect="light"
                                                :content="ncfT('Admin.Home.CurrentVersion', item.version) + ' -> ' + ncfT('Admin.Home.UpdateVersion', item.newVersion)">
                                        <i class="fa fa-level-up version-upgrade-icon"></i>
                                    </el-tooltip>
                                </span>
                                <span v-if="item.menus.length > 0">
                                    <el-popover placement="right"
                                                width="270"
                                                trigger="click">
                                        <el-table v-if="refreshTable"
                                                  v-loading="loading"
                                                  :data="item.menus"
                                                  row-key="id"
                                                  :default-expand-all="isExpandAll"
                                                  :tree-props="{children: 'children', hasChildren: 'hasChildren'}"
                                                  max-height="250"
                                                  :show-header="false">
                                            <el-table-column prop="name" label="@AR["Admin.Home.MenuName"]" width="260">
                                                <template slot-scope="scope">
                                                    <a :href="scope.row.url">{{scope.row.name}}</a>
                                                </template>
                                            </el-table-column>
                                        </el-table>
                                        <el-button slot="reference" size="mini" icon="el-icon-s-fold"></el-button>
                                    </el-popover>
                                </span>
                            </div>
                            <a v-bind:href="'/Admin/XncfModule/Start/?uid='+item.uid">
                                <div class="component-item">
                                    <i :class="[item.icon, 'icon']"></i>
                                    <div class="description">{{item.description || ncfT('Admin.Home.NoDescription')}}</div>
                                </div>
                            </a>
                        </el-card>

                    </el-col>
                </el-row>
            </div>
        </el-card>
    </el-row>
</div>

@section scripts {
    <script src="~/lib/echarts/dist/echarts.js"></script>
    <script src="~/js/Admin/Pages/Index/Index.js" asp-append-version="true"></script>
}
