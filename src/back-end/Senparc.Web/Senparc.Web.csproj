<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>0.39.0</Version>
<AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
		<TypeScriptToolsVersion>4.1</TypeScriptToolsVersion>
		<UserSecretsId>d2144151-af7a-4d50-896d-4a306e594f7b</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
		<Configurations>Debug;Release;Debug-Dapr;NcfDebugForPromptRange;ModifyPublish</Configurations>
		<ImplicitUsings>enable</ImplicitUsings>
		<!--<RestoreFallbackFolders>clear</RestoreFallbackFolders>-->
		<DefineConstants Condition="'$(Configuration)|$(Platform)'=='NcfDebugForPromptRange|AnyCPU'">$(DefineConstants);DEBUG</DefineConstants>
		<PackageReleaseNotes>
			[2026-08-04] v0.36.0 Added download page and database upgrade/maintenance mode
			1. Provided NCF download and development resource pages, and improved site multi-language display.
			2. Checked database migration status at startup; when not ready, isolated business requests and opened maintenance page.
			3. Supported independent upgrade command with --database-upgrade and staged progress output.
			4. Upgraded all Senparc.* NuGet dependencies and synchronized to latest extension module versions.
			[2026-08-08] v0.37.0 Provided DesktopBridge; added "NeuBell" feature; improved admin UI; supported multi-host deployment
			[2026-08-25] v0.39.0 Add Workflow and Sandbox module
		</PackageReleaseNotes>
	</PropertyGroup>
