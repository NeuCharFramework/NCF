@model Senparc.Web.Models.VD.BasePageModel
@using Senparc.Ncf.XncfBase
@inject IServiceProvider _serviceProvider
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
}
@functions{
    private async Task<bool> CheckXncfModuleValiable(string xncfName)
    {
        XncfRegisterManager xncfRegisterManager = new XncfRegisterManager(_serviceProvider);
        return await xncfRegisterManager.CheckXncfAvailable(xncfName).ConfigureAwait(false);
    }
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @SR["Site.MetaDescription"]</title>

    <environment include="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.1.3/css/bootstrap.min.css"
              asp-fallback-href="~/lib/bootstrap/dist/css/bootstrap.min.css"
              asp-fallback-test-class="sr-only" asp-fallback-test-property="position" asp-fallback-test-value="absolute"
              crossorigin="anonymous"
              integrity="sha256-eSi1q2PG6J7g7ib17yAaWMcrr5GrtohYChqibrV7PBE=" />
    </environment>
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/Index/index.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 ncf-navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">@SR["Nav.Brand"]</a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="@SR["Nav.ToggleNavigation"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
                    <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Download">@SR["Nav.Download"]</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="https://doc.ncf.pub" target="_blank">@SR["Nav.Documentation"]</a>
                                </li>

                        @{
                            if (await CheckXncfModuleValiable("Senparc.Xncf.Swagger"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/swagger" target="_blank">API Swagger</a>
                                </li>
                            }
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="https://weixin.senparc.com/QA" target="_blank">@SR["Nav.Community"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Admin" asp-page="/Index">@SR["Nav.AdminLogin"]</a>
                        </li>
                        <li class="nav-item d-flex align-items-center ml-sm-auto mr-sm-3">
                            <label for="ncf-site-lang" class="sr-only">@SR["Language.SelectLanguage"]</label>
                            <select id="ncf-site-lang" class="form-control form-control-sm" onchange="ncfSwitchLanguage(this.value)" aria-label="@SR["Language.SelectLanguage"]">
                                <option value="zh-CN" selected="@(currentCulture == "zh-CN" ? "selected" : null)">@SR["Language.zh-CN"]</option>
                                <option value="en" selected="@(currentCulture.StartsWith("en") ? "selected" : null)">@SR["Language.en"]</option>
                                <option value="ja" selected="@(currentCulture.StartsWith("ja") ? "selected" : null)">@SR["Language.ja"]</option>
                                <option value="fr" selected="@(currentCulture.StartsWith("fr") ? "selected" : null)">@SR["Language.fr"]</option>
                                <option value="es" selected="@(currentCulture.StartsWith("es") ? "selected" : null)">@SR["Language.es"]</option>
                                <option value="ru" selected="@(currentCulture.StartsWith("ru") ? "selected" : null)">@SR["Language.ru"]</option>
                            </select>
                        </li>
                    </ul>
                </div>
                <div class="header-icon">
                    <a href="https://github.com/NeuCharFramework/NCF" target="_blank">
                        <img src="~/images/Icon/github.svg" alt="@SR["Nav.GitHub"]" />
                    </a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @*<partial name="_CookieConsentPartial" />*@
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container pt-1 pl-5 pr-5 pb-1">
            <div class=" pl-5 pr-5">
                <div class="row">
                    <div class="col-lg-4 col-md-4 col-6">
                        <span class="footer-title">@SR["Footer.Community"]</span>
                        <ul>
                            <li>
                                <a href="https://github.com/NeuCharFramework/NCF" target="_blank">
                                    GitHub
                                </a>
                            </li>
                            <li>
                                <a onclick="unopen()">@SR["Footer.Events"]</a>
                            </li>
                            <li>
                                <a onclick="unopen()">@SR["Footer.Contribute"]</a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-lg-4 col-md-4 col-6">
                        <span class="footer-title">@SR["Footer.Documentation"]</span>
                        <ul>
                            <li>
                                <a href="https://doc.ncf.pub/zh/start/start-develop/get-ncf-template.html" target="_blank">@SR["Footer.StartDevelopment"]</a>
                            </li>
                            <li>
                                <a href="https://doc.ncf.pub/zh/start/qa/explanation_of_terms.html" target="_blank">@SR["Footer.Glossary"]</a>
                            </li>
                            <li>
                                <a href="https://doc.ncf.pub/zh/start/qa/common_problem.html" target="_blank">@SR["Footer.Faq"]</a>
                            </li>
                            <li>
                                <a href="https://doc.ncf.pub/zh/start/release/log.html" target="_blank">@SR["Footer.ReleaseNotes"]</a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-lg-4 col-md-4  col-6">
                        <span class="footer-title">@SR["Footer.ContactUs"]</span>
                        <div>
                            <a href="javascript:;" id="qq-code">
                                <img class="footer-img" src="~/images/Icon/qq.svg" />
                                <span id="qq-code-img" class="dn" p-id="107">
                                    <img src="~/images/Index/qq-code-img.webp" />
                                </span>
                            </a>
                            @*<a href="javascript:;">
                                    <img class="footer-img" src="~/images/Icon/mail.svg" />
                                </a>
                                <a href="javascript:;">
                                    <img class="footer-img" src="~/images/Icon/wechat.svg" />
                                </a>*@
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <p class="footer-copyright text-center">
                        <a href="http://beian.miit.gov.cn" target="_blank">苏ICP备11023884号-12</a> © 2025 Senparc
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"
                asp-fallback-src="~/lib/jquery/dist/jquery.min.js"
                asp-fallback-test="window.jQuery"
                crossorigin="anonymous"
                integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=">
        </script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.1.3/js/bootstrap.bundle.min.js"
                asp-fallback-src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"
                asp-fallback-test="window.jQuery && window.jQuery.fn && window.jQuery.fn.modal"
                crossorigin="anonymous"
                integrity="sha256-E/V4cWE4qvAeO5MOhjtGtqDzPndRO1LBk8lJ/PR7CA4=">
        </script>
    </environment>
    <partial name="_LocalizationScripts" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Index/index.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
