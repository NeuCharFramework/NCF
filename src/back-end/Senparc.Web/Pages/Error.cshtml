@page
@model ErrorModel
@{
    ViewData["Title"] = SR["Error.Title"];
}

<h1 class="text-danger">@SR["Error.Title"]</h1>
<h2 class="text-danger">@SR["Error.RequestFailed"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@SR["Error.RequestId"]:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@SR["Error.DevelopmentMode"]</h3>
<p>
    @SR["Error.DevelopmentDetails"]
</p>
<p>
    <strong>@SR["Error.DevelopmentWarning"]</strong>
    @SR["Error.DevelopmentInstructions"]
</p>
